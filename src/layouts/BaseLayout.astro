---
import '../styles/global.css';
import { faqSchemaEntries } from '../data/faq';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  robots?: string;
  /** Set on pages that have no real URL of their own (the 404 body is served
   *  for arbitrary paths), so we don't point a canonical at a URL that 404s. */
  noCanonical?: boolean;
}

const {
  title = "GuruDokAI — AI Pembuat RPP, Modul Ajar & LKPD",
  description = "GuruDokAI membantu guru Indonesia menyusun RPP, RPM, Modul Ajar, dan LKPD berbasis AI sesuai Kurikulum Merdeka. Tersedia juga CBT Sekolah untuk ujian online, sekali bayar Rp100.000.",
  keywords = "sistem administrasi pembelajaran guru, aplikasi administrasi guru, AI untuk guru, RPP Kurikulum Merdeka, aplikasi modul ajar, generator modul ajar, generator ATP, generator KKTP, RPP Cinta Kemenag, RPM Kemendikdasmen, LKPD Interaktif, CBT Sekolah, aplikasi ujian online sekolah, GuruDokAI",
  robots = "index, follow",
  noCanonical = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://gurudokai.supathub.my.id');
const ogImageURL = new URL('/og-image.png', canonicalURL);
const isHomePage = Astro.url.pathname === '/';

const SITE = 'https://gurudokai.supathub.my.id';

// One @graph so Google/AI see a single linked entity set instead of three
// disconnected blobs. Facts mirror the visible pages (Pricing, FAQ, /tentang/).
const homeGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE}/#organization`,
      "name": "GuruDokAI",
      "url": `${SITE}/`,
      "logo": `${SITE}/og-image.png`,
      "description": "Pengembang perangkat lunak pendidikan untuk guru Indonesia, meliputi aplikasi desktop GuruDokAI dan aplikasi Android BiraaStudio (SiAjar, Rekap Guru, SiUjian, SiKelas).",
      "founder": {
        "@type": "Person",
        "name": "Ahmad Saoghi",
        "jobTitle": "Founder & Lead Developer GuruDokAI",
        "url": `${SITE}/tentang/`
      },
      "sameAs": [
        "https://play.google.com/store/apps/dev?id=8704276077631485252",
        "https://lynk.id/oghiezr"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+62-851-8953-6359",
        "contactType": "customer support",
        "areaServed": "ID",
        "availableLanguage": "id"
      }
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      "name": "GuruDokAI",
      "url": `${SITE}/`,
      "inLanguage": "id-ID",
      "publisher": { "@id": `${SITE}/#organization` }
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${SITE}/#gurudokai`,
      "name": "GuruDokAI",
      "url": `${SITE}/`,
      "description": "Aplikasi desktop berbasis AI untuk guru Indonesia menyusun RPP, RPM, Modul Ajar, LKPD, ATP, KKTP, dan bank soal sesuai kurikulum nasional.",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "Windows 10, Windows 11",
      "inLanguage": "id-ID",
      "publisher": { "@id": `${SITE}/#organization` },
      "audience": {
        "@type": "EducationalAudience",
        "educationalRole": "teacher",
        "audienceType": "Guru SD, MI, SMP, MTs, SMA, MA, dan SMK di Indonesia"
      },
      "offers": [
        {
          "@type": "Offer",
          "name": "Paket Bulanan",
          "price": "19000",
          "priceCurrency": "IDR",
          "url": "https://lynk.id/oghiezr/zxjox857nz71"
        },
        {
          "@type": "Offer",
          "name": "Paket 3 Bulan",
          "price": "39900",
          "priceCurrency": "IDR",
          "url": "https://lynk.id/oghiezr/3nvl34y0q7l5"
        },
        {
          "@type": "Offer",
          "name": "Paket Tahunan",
          "price": "99000",
          "priceCurrency": "IDR",
          "url": "https://lynk.id/oghiezr/xwq6nyynj3zy",
          "eligibleQuantity": {
            "@type": "QuantitativeValue",
            "value": 1,
            "unitText": "tahun"
          }
        },
        {
          "@type": "Offer",
          "name": "Paket Lifetime",
          "price": "199000",
          "priceCurrency": "IDR",
          "url": "https://lynk.id/oghiezr/mp8dw5lyp3ey"
        }
      ],
      "isRelatedTo": [
        { "@type": "SoftwareApplication", "name": "CBT Sekolah", "url": `${SITE}/#cbt` },
        { "@type": "SoftwareApplication", "name": "SiAjar", "url": `${SITE}/rekomendasi/siajar/` },
        { "@type": "SoftwareApplication", "name": "Rekap Guru", "url": `${SITE}/rekomendasi/rekap-guru/` },
        { "@type": "SoftwareApplication", "name": "SiUjian", "url": `${SITE}/rekomendasi/siujian/` },
        { "@type": "SoftwareApplication", "name": "SiKelas", "url": `${SITE}/rekomendasi/sikelas/` }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${SITE}/#cbt-sekolah`,
      "name": "CBT Sekolah",
      "alternateName": "CBT Sekolah GuruDokAI",
      "url": `${SITE}/#cbt`,
      "description": "Aplikasi CBT (Computer Based Test) untuk ujian online sekolah: data siswa, bank soal, kontrol sesi ujian, monitoring siswa secara langsung, dan rekap nilai otomatis dalam format Excel dan PDF. Setiap sekolah memakai tenant sendiri.",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "Web browser",
      "inLanguage": "id-ID",
      "publisher": { "@id": `${SITE}/#organization` },
      "audience": {
        "@type": "EducationalAudience",
        "educationalRole": "teacher",
        "audienceType": "Guru, wali kelas, dan operator sekolah di Indonesia"
      },
      "featureList": [
        "Panel admin dan guru",
        "Data siswa dengan import Excel",
        "Bank soal pilihan tunggal dan pilihan kompleks dengan gambar",
        "Kontrol buka dan tutup sesi ujian",
        "Live student monitoring",
        "Monitoring pelanggaran dan reset login siswa",
        "Recovery koneksi dan auto-submit",
        "Rekap nilai instan format XLSX dan PDF"
      ],
      "offers": {
        "@type": "Offer",
        "name": "CBT Sekolah — Sekali Bayar (Lifetime)",
        "price": "100000",
        "priceCurrency": "IDR",
        "url": `${SITE}/#cbt-harga`,
        "availability": "https://schema.org/InStock"
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${SITE}/#faq`,
      "isPartOf": { "@id": `${SITE}/#website` },
      "mainEntity": faqSchemaEntries
    }
  ]
};
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robots} />
    <meta name="google-site-verification" content="VEz9elfN0FKuf0PQrs0Fk4KB42m7dEK_hMOaX_BYn_k" />
    <meta name="msvalidate.01" content="8B756066EF5115180B395DB4B2F92565" />
    {!noCanonical && <link rel="canonical" href={canonicalURL} />}
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GuruDokAI — AI administrasi guru Indonesia" />
    <meta property="og:site_name" content="GuruDokAI" />
    <meta property="og:locale" content="id_ID" />
    <link rel="alternate" type="text/plain" title="LLMs.txt" href="/llms.txt" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Self-hosted Fonts Preload -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/plus-jakarta-sans-v12-latin-500.woff2" crossorigin />

    <!-- Homepage-only entity graph. Detail pages provide their own entity data. -->
    {isHomePage && <script type="application/ld+json" set:html={JSON.stringify(homeGraph)} />}


  </head>
  <body class="antialiased text-gray-800 bg-white">
    <slot />
  </body>
</html>

---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const {
  title = "GuruDokAI - AI Pembuat RPP, Modul Ajar & LKPD",
  description = "GuruDokAI membantu guru membuat RPP, Modul Ajar, LKPD, asesmen, jurnal, dan administrasi pembelajaran berbasis AI sesuai Kurikulum Merdeka.",
  keywords = "sistem administrasi pembelajaran guru, aplikasi administrasi guru, AI untuk guru, RPP Kurikulum Merdeka, aplikasi modul ajar, generator modul ajar, generator ATP, generator KKTP, RPP Cinta Kemenag, RPM Kemendikdasmen, LKPD Interaktif, GuruDokAI"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://gurudokailanding.pages.dev');
const ogImageURL = new URL('/og-image.png', canonicalURL);
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="google-site-verification" content="lAoqLwn0RZG5EdZC2CEGvGCg3bnALu8Ek-Vp862247U" />
    <meta name="msvalidate.01" content="8B756066EF5115180B395DB4B2F92565" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="id_ID" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <!-- Google Fonts Preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Schema: SoftwareApplication -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "GuruDokAI",
        "description": "Aplikasi AI asisten guru Indonesia untuk membuat RPP, Modul Ajar, Bank Soal HOTS, ATP otomatis sesuai Kurikulum Merdeka",
        "applicationCategory": "EducationalApplication",
        "operatingSystem": "Android, iOS, Windows, macOS, Web",
        "author": {
          "@type": "Organization",
          "name": "GuruDokAI"
        },
        "offers": [
          {
            "@type": "Offer",
            "name": "Paket Bulanan",
            "price": "19000",
            "priceCurrency": "IDR",
            "url": "https://lynk.id/oghiezr/zxjox857nz71"
          },
          {
            "@type": "Offer",
            "name": "Paket 3 Bulan",
            "price": "39900",
            "priceCurrency": "IDR",
            "url": "https://lynk.id/oghiezr/zxjox857nz71"
          },
          {
            "@type": "Offer",
            "name": "Paket Tahunan",
            "price": "99000",
            "priceCurrency": "IDR",
            "url": "https://lynk.id/oghiezr/zxjox857nz71",
            "eligibleQuantity": {
              "@type": "QuantitativeValue",
              "value": 1,
              "unitText": "tahun"
            }
          },
          {
            "@type": "Offer",
            "name": "Paket Lifetime",
            "price": "199000",
            "priceCurrency": "IDR",
            "url": "https://lynk.id/oghiezr/zxjox857nz71"
          }
        ]
      }
    </script>

    <!-- Schema: FAQPage -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Apakah GuruDokAI merupakan aplikasi administrasi guru otomatis?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ya, GuruDokAI adalah aplikasi administrasi guru otomatis sekaligus pelopor AI pendidikan Indonesia dan perangkat ajar AI terdepan. Platform ini berfungsi sebagai pembuat RPP otomatis, pembuat modul ajar, dan generator LKPD interaktif untuk memproses seluruh berkas administrasi pembelajaran Anda secara instan dan praktis."
            }
          },
          {
            "@type": "Question",
            "name": "Apakah GuruDokAI sesuai Kurikulum Merdeka?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ya, sebagai pelopor aplikasi Kurikulum Merdeka berbasis kecerdasan buatan, GuruDokAI mendukung penuh format RPP dan Modul Ajar terbaru yang disesuaikan dengan Permendikdasmen No.13/2025 tentang prinsip Deep Learning."
            }
          },
          {
            "@type": "Question",
            "name": "Apakah GuruDokAI memiliki aplikasi Android dan Windows?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ya, betul sekali. GuruDokAI tersedia sebagai aplikasi desktop untuk perangkat komputer Windows 10 & 11, serta aplikasi Android resmi bernama SiAjar yang bisa diunduh di Google Play Store. Website resmi kami berfungsi sebagai pusat informasi dan panduan produk untuk mengunduh aplikasi tersebut."
            }
          },
          {
            "@type": "Question",
            "name": "Jenjang sekolah apa saja yang didukung oleh GuruDokAI?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Sebagai aplikasi guru SD, MI, SMP, MTs, SMA, MA, dan SMK, GuruDokAI dirancang fleksibel untuk mendukung pembuatan administrasi pembelajaran lengkap di berbagai jenjang sekolah di Indonesia, baik sekolah umum maupun madrasah di bawah naungan Kemenag."
            }
          },
          {
            "@type": "Question",
            "name": "Berapa biaya berlangganan GuruDokAI?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Kami menawarkan paket berlangganan yang sangat hemat untuk guru Indonesia. Paket Bulanan mulai dari Rp 19.000, paket 3 Bulan seharga Rp 39.900, paket Tahunan seharga Rp 99.000 (hanya Rp 8.250/bulan), dan paket Lifetime seharga Rp 199.000 untuk akses selamanya tanpa tagihan bulanan."
            }
          },
          {
            "@type": "Question",
            "name": "Apakah data sekolah dan dokumen saya aman?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Sangat aman. Seluruh data sekolah, data murid, dan dokumen administrasi yang Anda generate terenkripsi secara aman, bersifat privat, dan tidak akan dibagikan kepada pihak ketiga manapun."
            }
          },
          {
            "@type": "Question",
            "name": "Kalau ada pertanyaan, bisa hubungi siapa?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Tim bantuan GuruDokAI siap mendampingi Anda kapan saja. Anda bisa langsung menghubungi CS kami melalui WhatsApp di nomor +6285189536359 untuk bantuan teknis maupun aktivasi."
            }
          }
        ]
      }
    </script>
    
    <!-- Cloudflare Web Analytics Snippet -->
    <!-- Note: Token can be injected via Cloudflare Dashboard or manual deployment scripts -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "f5d082be05e94b29b63ef28258bbf9d0"}'></script>
  </head>
  <body class="antialiased text-gray-800 bg-white">
    <slot />
  </body>
</html>

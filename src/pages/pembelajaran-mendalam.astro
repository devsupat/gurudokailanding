---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Footer from '../components/Footer.astro';

// Custom SEO Meta Data
const title = "Pembelajaran Mendalam (Deep Learning) di Kelas | GuruDokAI";
const description = "Panduan lengkap penerapan prinsip Pembelajaran Mendalam (Deep Learning) dalam pendidikan Indonesia. Ketahui 3 pilar: Mindful, Meaningful, dan Joyful Learning.";
const keywords = "pembelajaran mendalam, deep learning pendidikan, rencana pembelajaran mendalam, rpm kurikulum merdeka, rppm, kbc kemenag, ai guru indonesia";

const pageUrl = "https://gurudokai.supathub.my.id/pembelajaran-mendalam/";

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Beranda",
      "item": "https://gurudokai.supathub.my.id/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Pembelajaran Mendalam (Deep Learning)",
      "item": pageUrl
    }
  ]
};

// Custom FAQ for Deep Learning
const dlFaqs = [
  {
    question: "Apa itu prinsip Pembelajaran Mendalam (Deep Learning) dalam pendidikan?",
    answer: "<strong>Pembelajaran Mendalam (Deep Learning)</strong> adalah pendekatan pedagogi yang menekankan keterlibatan aktif murid untuk memahami materi secara mendalam. Pendekatan ini menghindari hafalan pasif dan memprioritaskan pemecahan masalah serta integrasi karakter."
  },
  {
    question: "Apa saja 3 pilar utama dalam Deep Learning?",
    answer: "Tiga pilar utamanya adalah: <strong>1. Mindful Learning</strong>: menghargai keunikan potensi, minat, dan cara belajar individu yang berbeda. <strong>2. Meaningful Learning</strong>: mendorong murid berpikir aktif dan bernalar kritis demi memahami manfaat materi di dunia nyata. <strong>3. Joyful Learning</strong>: menciptakan suasana belajar yang menyenangkan, memotivasi, dan bermakna agar pengetahuan melekat lebih lama."
  },
  {
    question: "Bagaimana GuruDokAI membantu guru mengadopsi Deep Learning?",
    answer: "GuruDokAI menyediakan generator otomatis untuk menyusun <strong>RPM (Rencana Pembelajaran Mendalam)</strong> dan <strong>RPPM</strong> berbasis pilar Deep Learning secara instan."
  },
  {
    question: "Apakah Pembelajaran Mendalam ini relevan untuk guru madrasah?",
    answer: "Sangat relevan. Kementerian Agama (Kemenag) menyelaraskan prinsip ini melalui <strong>Kurikulum Berbasis Cinta (KBC)</strong>. GuruDokAI mendukung penuh pembuatan modul ajar khusus KBC."
  }
];

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": dlFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer.replace(/<\/?[^>]+(>|$)/g, "")
    }
  }))
};

const dlSteps = [
  {
    badge: "Big Idea",
    title: "Langkah 1/4: Identifikasi Konsep Esensial",
    lines: [
      "PEMBELAJARAN MENDALAM (DEEP LEARNING)",
      "=====================================",
      "Sekolah        : SMP Negeri Harapan",
      "Mata Pelajaran : IPA (Sains)",
      "Fase / Kelas   : D / VIII",
      "Topik          : Tekanan Zat & Penerapannya",
      "\n[KONSEP ESENSIAL / BIG IDEA]",
      "Hukum Pascal menjelaskan bagaimana gaya kecil dapat menghasilkan gaya besar yang mempermudah pekerjaan manusia."
    ]
  },
  {
    badge: "Mindful",
    title: "Langkah 2/4: Pilar 1 - Mindful Learning",
    lines: [
      "\n[PILAR 1: MINDFUL LEARNING]",
      "• Menyadari keunikan murid. Guru memetakan minat & cara belajar individu yang berbeda.",
      "• Refleksi: Mengapa cairan di dalam dongkrak mobil bisa menahan kendaraan berat? Relevan dengan lingkungan sekitar murid."
    ]
  },
  {
    badge: "Meaningful & Joyful",
    title: "Langkah 3/4: Pilar 2 & 3 - Meaningful & Joyful",
    lines: [
      "\n[PILAR 2: MEANINGFUL LEARNING]",
      "• Murid secara aktif mendiskusikan & memecahkan masalah kebocoran fluida menggunakan suntikan plastik bekas.",
      "\n[PILAR 3: JOYFUL LEARNING]",
      "• Murid berkolaborasi secara berkelompok dalam aktivitas eksperimen sains yang menantang dan menyenangkan."
    ]
  },
  {
    badge: "Asesmen",
    title: "Langkah 4/4: Evaluasi & Asesmen Autentik",
    lines: [
      "\n[ASESMEN DEEP LEARNING]",
      "• Asesmen Formatif: Laporan praktikum pembuatan dongkrak hidrolik mini.",
      "• Kriteria Kelulusan: Menggunakan rubrik KKTP Deskripsi Kriteria.",
      "\n--------------------------------------------",
      "RANCANGAN AKTIVITAS DEEP LEARNING SELESAI!"
    ]
  }
];
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <!-- Schema Injection -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Header />
  <main>
    <Hero 
      badge="Pedagogi Pembelajaran Mendalam"
      titleHtml="Penerapan Pembelajaran Mendalam <br class='hidden sm:inline' /> <span class='text-brand-primary bg-gradient-to-r from-brand-primary to-brand-dark bg-clip-text text-transparent'>(Deep Learning) dengan Asisten AI</span>"
      description="Pelajari cara mengimplementasikan prinsip Pembelajaran Mendalam (Deep Learning) di kelas menggunakan asisten kecerdasan buatan GuruDokAI."
      mapel="Ilmu Pengetahuan Alam (IPA)"
      kelas="Kelas 8 SMP · Fase D"
      topik="Tekanan Zat dan Hukum Pascal dalam Kehidupan"
      steps={dlSteps}
    />

    <!-- Semantic Content Section -->
    <section class="py-20 bg-slate-50 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-16 space-y-4">
          <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight leading-tight">
            Membangun Keterampilan Abad 21 Melalui <span class="text-brand-primary">Pembelajaran Mendalam</span>
          </h2>
          <p class="text-lg text-gray-600 font-medium">
            Dalam era kecerdasan buatan, tantangan murid bukan lagi sekadar menghafal konten. <strong>Pembelajaran Mendalam (Deep Learning)</strong> melatih cara berpikir kritis, memecahkan masalah kompleks, berkolaborasi secara sehat, serta membentuk kepribadian mulia murid.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="space-y-6 text-gray-600 font-medium leading-relaxed font-semibold">
            <h3 class="text-2xl font-bold text-gray-900 leading-tight">
              AI Guru Indonesia untuk Membantu Transisi Pedagogi
            </h3>
            <p class="text-gray-500 font-semibold">
              Banyak guru mengalami kendala dalam merumuskan skenario pembelajaran aktif yang runtut. GuruDokAI menjembatani kebutuhan tersebut dengan merumuskan draf rancangan <strong>RPM (Rencana Pembelajaran Mendalam)</strong>, <strong>RPPM (Mingguan)</strong>, pembuatan <strong>Modul Ajar</strong>, penyusunan alur <strong>ATP</strong>, hingga rumusan tujuan <strong>TP</strong> dan indikator <strong>KKTP</strong>.
            </p>
            <p class="text-gray-500 font-semibold">
              Kombinasi AI cerdas dan pedagogi modern memperkuat efektivitas waktu kerja administrasi guru secara optimal, sehingga guru bisa berfokus penuh mendampingi proses belajar murid di dalam kelas.
            </p>
            <div class="pt-4 border-t border-gray-200 space-y-3">
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="lucide lucide-check"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span class="text-sm font-bold text-gray-900">Membantu guru menyusun rancangan pembelajaran berbasis pilar Deep Learning.</span>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="lucide lucide-check"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span class="text-sm font-bold text-gray-900">Menyediakan opsi perangkat ajar bagi guru madrasah berprinsip Kurikulum Berbasis Cinta (KBC).</span>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="lucide lucide-check"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span class="text-sm font-bold text-gray-900">Terintegrasi dengan generator <a href="/ai-pembuat-rpm/" class="text-brand-primary hover:underline">RPM otomatis</a>, <a href="/lkpd/" class="text-brand-primary hover:underline">LKPD</a>, dan asesmen lengkap.</span>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-pink-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart-handshake"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M12 5 9.04 7.96a2.17 2.17 0 0 0 0 3.08v0c.82.82 2.13.85 3 .07l2.07-1.9a2.82 2.82 0 0 1 3.79-.07l1.94 1.86"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Kurikulum Berbasis Cinta</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                Skenario belajar madrasah yang menekankan nilai empati, spiritualitas, dan cinta kasih sesama.
              </p>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-pink-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-brain-circuit"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"/><path d="M9 13h4"/><path d="M12 10v6"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Metakognisi Murid</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                Melatih kemampuan merefleksikan proses berpikir mandiri dalam memahami materi esensial.
              </p>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-pink-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-badge"><path d="M4 22V4a2 2 0 0 1 2-2h8.5L20 7.5V14"/><path d="M14 2v6h6"/><circle cx="8" cy="16" r="4"/><path d="m10.2 18.2 1.8 1.8"/><path d="m5.8 18.2-1.8 1.8"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Asesmen Autentik</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                Mengukur keberhasilan belajar dari unjuk kerja nyata murid, bukan sekadar tes pilihan ganda.
              </p>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-pink-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Modul Siap Cetak</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                Ekspor instan hasil rancangan belajar ke format Word untuk memudahkan edit atau adaptasi kelas.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <Pricing />

    <!-- Testimonials Section -->
    <Testimonials />

    <!-- FAQ Section -->
    <FAQ faqs={dlFaqs} />

    <!-- CTA Section -->
    <CTAFinal />
  <RelatedLinks
    links={[
        { href: "/knowledge/apa-itu-rpm/", label: "Apa itu Rencana Pembelajaran Mendalam (RPM)", note: "Dokumen perencanaan resmi yang menerjemahkan prinsip pembelajaran mendalam." },
        { href: "/rencana-pembelajaran-mendalam/", label: "Format dan Struktur RPM", note: "Komponen dokumen RPM beserta contoh susunannya." },
        { href: "/knowledge/cara-menyusun-modul-ajar-deep-learning/", label: "Cara Menyusun Modul Ajar Deep Learning", note: "Langkah praktis menurunkan prinsip deep learning ke modul ajar." }
    ]}
  />
  </main>
  <Footer />
</BaseLayout>

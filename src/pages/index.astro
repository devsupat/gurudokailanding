---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PainPoint from '../components/PainPoint.astro';
import Demo from '../components/Demo.astro';
import Features from '../components/Features.astro';
import Pricing from '../components/Pricing.astro';
import CbtProduct from '../components/CbtProduct.astro';
import Testimonials from '../components/Testimonials.astro';
import BiraaEcosystem from '../components/BiraaEcosystem.astro';
import FAQ from '../components/FAQ.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Footer from '../components/Footer.astro';
const title = "GuruDok AI — AI Administrasi Guru & CBT Ujian Online Sekolah";
const description = "GuruDok AI membantu guru menyusun RPP, Modul Ajar, dan administrasi pembelajaran dengan AI. Tersedia juga CBT Sekolah untuk kelola ujian online sekolah tanpa ribet.";
const keywords = "GuruDok AI, AI untuk guru, aplikasi RPP otomatis, CBT Sekolah, aplikasi CBT sekolah, ujian online sekolah, generator modul ajar, administrasi guru";
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <Header />
  <main>
    <Hero />
    <PainPoint />
    <Demo />
    <Features />
    <Pricing />
    <CbtProduct />
    <Testimonials />
    <BiraaEcosystem />
    <FAQ />
    <CTAFinal />
  </main>
  <Footer />
</BaseLayout>

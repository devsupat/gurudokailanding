---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Footer from '../components/Footer.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import TopicGuide from '../components/TopicGuide.astro';
import { kktpGuide } from '../data/topics';

// Custom SEO Meta Data
const title = "Generator KKTP & IKTP Otomatis Berbasis AI | GuruDokAI";
const description = "Tentukan Kriteria Ketercapaian Tujuan Pembelajaran (KKTP) dan IKTP otomatis dengan AI: interval nilai, rubrik deskriptif, dan skala penilaian.";
const keywords = "generator kktp, kktp kurikulum merdeka, kriteria ketercapaian tujuan pembelajaran, iktp otomatis, asesmen sumatif, rpp kurikulum merdeka, rpm ai";

const pageUrl = "https://gurudokai.supathub.my.id/generator-kktp/";

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Beranda",
      "item": "https://gurudokai.supathub.my.id/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Generator KKTP",
      "item": pageUrl
    }
  ]
};

// Custom FAQ for KKTP
const kktpFaqs = [
  {
    question: "Apa itu KKTP (Kriteria Ketercapaian Tujuan Pembelajaran)?",
    answer: "<strong>KKTP (Kriteria Ketercapaian Tujuan Pembelajaran)</strong> adalah rangkaian kriteria atau indikator kualitatif yang menunjukkan tingkat penguasaan murid terhadap <strong>Tujuan Pembelajaran (TP)</strong>. KKTP menggantikan sistem KKM tunggal agar penilaian lebih bermakna dan berorientasi pada proses."
  },
  {
    question: "Metode penilaian KKTP apa saja yang didukung oleh GuruDokAI?",
    answer: "GuruDokAI mendukung 3 pendekatan resmi Kurikulum Merdeka: <strong>1. Rubrik Deskriptif</strong> (level Baru Berkembang s.d. Mahir), <strong>2. Deskripsi Kriteria</strong> (checklist ketercapaian esensial), dan <strong>3. Interval Nilai</strong> (persentase kelulusan beserta tindak lanjutnya)."
  },
  {
    question: "Bagaimana cara menyelaraskan KKTP dengan RPP, RPM, dan RPPM?",
    answer: "GuruDokAI secara otomatis menyinkronkan indikator KKTP dengan rumusan TP yang tertera pada draf <a href='/ai-pembuat-rpp/'>RPP</a>, <a href='/ai-pembuat-rpm/'>RPM</a>, atau <a href='/rppm/'>RPPM</a> Anda sehingga tidak terjadi ketidaksesuaian saat supervisi."
  },
  {
    question: "Apakah Generator KKTP memberikan rekomendasi remedial dan pengayaan?",
    answer: "Ya. Setiap rubrik yang dihasilkan melampirkan rekomendasi intervensi diagnostik: aktivitas remedial khusus untuk murid yang berada di interval rendah (< 75%) dan aktivitas pengayaan Tantangan HOTS untuk murid kategori Mahir."
  },
  {
    question: "Apakah rubrik KKTP ini cocok untuk guru SD, SMP, SMA, dan SMK?",
    answer: "Sangat cocok. Anda cukup memilih jenjang dan mata pelajaran, lalu sistem AI akan merumuskan kata kerja operasional (KKO) yang pas dengan tingkat perkembangan murid di jenjang tersebut."
  },
  {
    question: "Dapatkah hasil rubrik KKTP diekspor ke Microsoft Word?",
    answer: "Tentu saja. Dokumen KKTP dapat diekspor langsung ke format <strong>Microsoft Word (.docx)</strong> dan <strong>PDF</strong> yang siap dilampirkan ke dalam jurnal mengajar atau buku nilai guru."
  }
];

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": kktpFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer.replace(/<\/?[^>]+(>|$)/g, "")
    }
  }))
};

const kktpSteps = [
  {
    badge: "Input TP",
    title: "Langkah 1/4: Pilih Tujuan Pembelajaran (TP)",
    lines: [
      "KRITERIA KETERCAPAIAN TUJUAN PEMBELAJARAN (KKTP)",
      "================================================",
      "Mata Pelajaran : IPA (Sains)",
      "Fase / Kelas   : D / VII",
      "\n[TUJUAN PEMBELAJARAN (TP)]",
      "TP 7.5: Murid dapat mengidentifikasi klasifikasi makhluk hidup berdasarkan karakteristiknya."
    ]
  },
  {
    badge: "Metode",
    title: "Langkah 2/4: Pilih Pendekatan Rubrik",
    lines: [
      "\n[PILIHAN METODE EVALUASI]",
      "• Pendekatan: Rubrik Deskriptif 4 Kriteria",
      "• Indikator Ketercapaian (IKTP):",
      "  - Menyebutkan ciri-ciri makhluk hidup.",
      "  - Mengelompokkan hewan berdasarkan filum.",
      "  - Menjelaskan kunci dikotom sederhana."
    ]
  },
  {
    badge: "Generate",
    title: "Langkah 3/4: Penyusunan Rubrik Kompetensi",
    lines: [
      "\n[HASIL GENERATE RUBRIK KKTP]",
      "• Baru Berkembang (0-60%): Belum mampu membedakan karakteristik dasar.",
      "• Layak (61-75%): Mampu mengelompokkan hewan dengan bantuan guru.",
      "• Cakap (76-90%): Mampu membuat kunci dikotom sederhana secara mandiri.",
      "• Mahir (91-100%): Mampu menganalisis klasifikasi filum secara kompleks."
    ]
  },
  {
    badge: "Hasil",
    title: "Langkah 4/4: Tindak Lanjut & Ekspor",
    lines: [
      "\n[REKOMENDASI INTERVENSI]",
      "• Remedial: Pendampingan tutor sebaya untuk nilai < 75%.",
      "• Pengayaan: Meneliti taksonomi tanaman lokal sekolah.",
      "\n--------------------------------------------",
      "RUBRIK PENILAIAN KKTP SELESAI DIGENERATE!"
    ]
  }
];
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <!-- Schema Injection -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Header />
  <main>
    <Hero 
      badge="AI Generator KKTP & IKTP"
      titleHtml="Generator KKTP Kurikulum Merdeka AI <br class='hidden sm:inline' /> <span class='text-brand-primary bg-gradient-to-r from-brand-primary to-brand-dark bg-clip-text text-transparent'>Otomatis Rubrik & Interval Nilai</span>"
      description="Susun kriteria penilaian KKTP dan indikator IKTP secara detail, terukur, dan selaras dengan instrumen asesmen pembelajaran Anda hanya dalam hitungan detik."
      mapel="Ilmu Pengetahuan Alam (IPA)"
      kelas="Kelas 7 SMP · Fase D"
      topik="Elemen Klasifikasi Makhluk Hidup (Taksonomi)"
      steps={kktpSteps}
    />

    <!-- Semantic Content Section -->
    <section class="py-20 bg-slate-50 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-16 space-y-4">
          <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight leading-tight">
            Ukur Kompetensi Murid Secara Adil Menggunakan <span class="text-brand-primary">KKTP Otomatis</span>
          </h2>
          <p class="text-lg text-gray-600 font-medium">
            Sebagai bagian dari administrasi guru Kurikulum Merdeka, <strong>KKTP (Kriteria Ketercapaian Tujuan Pembelajaran)</strong> berperan vital untuk menilai ketuntasan belajar murid. KKTP membebaskan guru dari standar angka kaku KKM, beralih ke analisis kualitas performa murid yang autentik.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="space-y-6 text-gray-600 font-medium leading-relaxed font-semibold">
            <h3 class="text-2xl font-bold text-gray-900 leading-tight">
              Sinergi Penilaian Antara RPP/RPM Tradisional dengan KKTP AI
            </h3>
            <p class="text-gray-500 font-semibold">
              Menyusun KKTP membutuhkan ketelitian tinggi agar indikator kelulusan selaras dengan <strong>RPP Kurikulum Merdeka</strong> atau <strong>RPM (Rencana Pembelajaran Mendalam)</strong> terbaru.
            </p>
            <p class="text-gray-500 font-semibold">
              Melalui asisten AI Guru Indonesia GuruDokAI, Anda dapat memformulasikan rubrik deskriptif lengkap dengan kriteria remedial dan pengayaan dalam hitungan detik. Cukup impor rumusan <strong>TP</strong> atau <strong>ATP</strong> Anda, lalu AI akan menyelesaikan lembar penilaiannya.
            </p>
            <div class="pt-4 border-t border-gray-200 space-y-3">
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="lucide lucide-check"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span class="text-sm font-bold text-gray-900">Menghasilkan 3 jenis pendekatan KKTP secara otomatis sesuai pilihan Anda.</span>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="lucide lucide-check"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span class="text-sm font-bold text-gray-900">Cocok untuk sekolah umum Kemendikbudristek maupun madrasah Kemenag (KBC).</span>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="lucide lucide-check"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span class="text-sm font-bold text-gray-900">Hasil draf terintegrasi langsung dengan <a href="/ai-pembuat-lkpd/" class="text-brand-primary hover:underline">LKPD</a> dan rencana pembelajaran mingguan <a href="/rppm/" class="text-brand-primary hover:underline">RPPM</a>.</span>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-emerald-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-percent"><line x1="19" x2="5" y1="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Interval Nilai</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                Memetakan tingkat ketercapaian siswa menggunakan pembagian interval angka persentase.
              </p>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-emerald-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list-todo"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="m9 10 2 2 4-4"/><path d="M8 16h8"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Rubrik Deskriptif</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                Menyediakan tingkat kemampuan kualitatif murid dari Baru Berkembang hingga Mahir.
              </p>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-emerald-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-list"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Deskripsi Kriteria</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                Format sederhana berupa kriteria checklist untuk mengetahui ketercapaian esensial murid.
              </p>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-emerald-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart-handshake"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M12 5 9.04 7.96a2.17 2.17 0 0 0 0 3.08v0c.82.82 2.13.85 3 .07l2.07-1.9a2.82 2.82 0 0 1 3.79-.07l1.94 1.86"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Sesuai Kemenag KBC</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                  Rubrik evaluasi berbasis rasa cinta kasih yang menyokong program <a href="/kurikulum-berbasis-cinta/" class="text-brand-primary hover:underline">KBC madrasah</a>.
              </p>
            </div>
          </div>
        </div>

        <!-- Deep Dive Topic Section for KKTP -->
        <div class="mt-16 bg-white border border-slate-200 rounded-3xl p-8 sm:p-12 shadow-sm space-y-8">
          <div class="border-b border-gray-100 pb-6">
            <h3 class="text-2xl sm:text-3xl font-extrabold text-gray-900">
              Panduan Praktis Menyusun KKTP (Kriteria Ketercapaian Tujuan Pembelajaran)
            </h3>
            <p class="text-gray-500 font-semibold mt-2">
              Bagaimana memilih pendekatan rubrik dan menentukan batas ketuntasan belajar secara objektif.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="space-y-3">
              <div class="text-brand-primary font-bold text-sm uppercase tracking-wider">1. Pilih Pendekatan Rubrik</div>
              <h4 class="text-lg font-bold text-gray-900">Deskriptif vs Interval</h4>
              <p class="text-sm text-gray-600 font-medium leading-relaxed">
                Gunakan <strong>Rubrik Deskriptif</strong> untuk penilaian proyek/kinerja (Baru Berkembang s.d. Mahir). Gunakan <strong>Interval Nilai</strong> jika instrumen evaluasi berupa tes tertulis pilihan ganda/esai.
              </p>
            </div>

            <div class="space-y-3">
              <div class="text-brand-primary font-bold text-sm uppercase tracking-wider">2. Sinkronisasi TP & ATP</div>
              <h4 class="text-lg font-bold text-gray-900">Integrasi Alur Pembelajaran</h4>
              <p class="text-sm text-gray-600 font-medium leading-relaxed">
                Setiap indikator KKTP diturunkan dari rumusan <a href="/generator-tp/" class="text-brand-primary hover:underline font-bold">TP</a> dan disusun berdasarkan urutan <a href="/generator-atp/" class="text-brand-primary hover:underline font-bold">ATP</a> agar penilaian komprehensif.
              </p>
            </div>

            <div class="space-y-3">
              <div class="text-brand-primary font-bold text-sm uppercase tracking-wider">3. Rencana Tindak Lanjut</div>
              <h4 class="text-lg font-bold text-gray-900">Remedial & Pengayaan</h4>
              <p class="text-sm text-gray-600 font-medium leading-relaxed">
                KKTP GuruDokAI otomatis menyajikan draf intervensi: bantuan tutor sebaya bagi siswa yang belum tuntas dan tugas tantangan HOTS untuk siswa kategori Mahir.
              </p>
            </div>
          </div>

          <div class="bg-brand-light/30 border border-brand-primary/20 rounded-2xl p-6 text-sm text-gray-700 font-medium">
            <strong class="text-brand-primary font-bold block mb-1">💡 Tips Penilaian Kurikulum Merdeka:</strong>
            Hindari menetapkan satu angka kelulusan kaku untuk seluruh murid. Manfaatkan rubrik deskriptif KKTP untuk memberikan umpan balik (feedback) konstruktif bagi perkembangan tiap anak.
          </div>
        </div>

      </div>
    </section>

    <!-- Pricing Section -->
    <!-- Page-specific long-form content -->
    <TopicGuide guide={kktpGuide} />

    <Pricing />

    <!-- Testimonials Section -->
    <Testimonials />

    <!-- FAQ Section -->
    <FAQ faqs={kktpFaqs} />

    <!-- CTA Section -->
    <CTAFinal />

    <RelatedLinks
      heading="Dokumen yang berkaitan dengan KKTP"
      links={[
      { href: "/generator-tp/", label: "Generator TP", note: "Menyiapkan rumusan tujuan yang menjadi acuan kriteria." },
      { href: "/ai-pembuat-lkpd/", label: "Generator LKPD", note: "Menyediakan hasil kerja murid sebagai bukti penilaian." },
      { href: "/generator-modul-ajar/", label: "Generator Modul Ajar", note: "Menyatukan kriteria penilaian dengan rencana pembelajaran." },
      ]}
    />
  </main>
  <Footer />
</BaseLayout>

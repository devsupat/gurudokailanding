---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Footer from '../components/Footer.astro';

// Custom SEO Meta Data
const title = "AI Pembuat RPM (Rencana Pembelajaran Mendalam) Otomatis | GuruDokAI";
const description = "Buat RPM (Rencana Pembelajaran Mendalam) secara otomatis menggunakan AI sesuai prinsip Pembelajaran Mendalam (Deep Learning) Kemendikdasmen. Cepat, akurat, dan siap cetak.";
const keywords = "ai pembuat rpm, rencana pembelajaran mendalam, generator rpm otomatis, deep learning pendidikan, rppm otomatis, administrasi guru ai, kurikulum merdeka";

const pageUrl = "https://gurudokai.supathub.my.id/ai-pembuat-rpm";

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Beranda",
      "item": "https://gurudokai.supathub.my.id/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "AI Pembuat RPM",
      "item": pageUrl
    }
  ]
};

// Custom FAQ for RPM
const rpmFaqs = [
  {
    question: "Apa itu RPM (Rencana Pembelajaran Mendalam)?",
    answer: "<strong>RPM (Rencana Pembelajaran Mendalam)</strong> adalah perencanaan pembelajaran terbaru yang dirancang untuk mengintegrasikan prinsip-prinsip <strong>Pembelajaran Mendalam (Deep Learning)</strong>. RPM berfokus pada pemahaman konsep inti (Big Ideas), keterkaitan materi, relevansi kehidupan nyata, serta asesmen autentik yang berpusat pada murid."
  },
  {
    question: "Apa perbedaan utama antara RPP dan RPM?",
    answer: "Jika <strong>RPP (Rencana Pelaksanaan Pembelajaran)</strong> lebih berfokus pada penyelesaian kurikulum dan langkah instruksional guru secara umum, maka <strong>RPM (Rencana Pembelajaran Mendalam)</strong> mengutamakan kedalaman pemahaman siswa melalui 3 pilar utama: <i>Mindful Learning</i> (keunikan murid), <i>Meaningful Learning</i> (berpikir kritis), dan <i>Joyful Learning</i> (pembelajaran menyenangkan) untuk mencapai hasil belajar yang bermakna."
  },
  {
    question: "Apakah GuruDokAI mendukung pembuatan RPPM?",
    answer: "Ya. Selain RPM harian/unit, GuruDokAI juga menyediakan generator <strong>RPPM (Rencana Pelaksanaan Pembelajaran Mendalam Mingguan)</strong> secara instan untuk membantu Anda memetakan alur belajar mingguan secara terstruktur."
  },
  {
    question: "Bagaimana GuruDokAI merancang Asesmen dalam RPM?",
    answer: "GuruDokAI secara otomatis merumuskan tiga bentuk evaluasi terpadu: <strong>Asesmen Diagnostik</strong> (mengukur kesiapan awal murid), <strong>Asesmen Formatif</strong> (evaluasi proses pembelajaran), dan <strong>Asesmen Sumatif</strong> (evaluasi akhir capaian) lengkap dengan rubrik <strong>KKTP (Kriteria Ketercapaian Tujuan Pembelajaran)</strong>."
  },
  {
    question: "Apakah GuruDokAI mendukung Kurikulum Berbasis Cinta (KBC) Kemenag?",
    answer: "Tentu saja. GuruDokAI memfasilitasi kebutuhan <strong>guru madrasah</strong> (MI, MTs, MA) dengan menyediakan opsi pembuatan perangkat pembelajaran berbasis Kurikulum Berbasis Cinta (KBC)."
  }
];

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": rpmFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer.replace(/<\/?[^>]+(>|$)/g, "")
    }
  }))
};

const rpmSteps = [
  {
    badge: "CP-TP",
    title: "Langkah 1/4: Analisis CP & Kompetensi Mendalam",
    lines: [
      "RENCANA PEMBELAJARAN MENDALAM (RPM)",
      "==================================",
      "Sekolah        : SD Indonesia Sejahtera",
      "Mata Pelajaran : IPAS (Sains)",
      "Fase / Kelas   : C / V",
      "Topik          : Siklus Air & Kehidupan",
      "\n[ANALISIS CAPAIAN PEMBELAJARAN]",
      "Murid menganalisis siklus air dan pengaruhnya bagi kehidupan sehari-hari.",
      "\n[IDE UTAMA (BIG IDEA)]",
      "Air adalah sumber kehidupan yang terus bersirkulasi, kelestarian air berdampak langsung pada keberlangsungan ekosistem."
    ]
  },
  {
    badge: "Pemantik",
    title: "Langkah 2/4: Merancang Pertanyaan Pemantik & Konsep Esensial",
    lines: [
      "\n[PERTANYAAN PEMANTIK (ESSENTIAL QUESTIONS)]",
      "1. Dari mana datangnya hujan dan ke mana perginya air setelah membasahi bumi?",
      "2. Mengapa air di bumi tidak pernah habis meskipun terus-menerus kita gunakan?",
      "\n[KONSEP ESENSIAL]",
      "Evaporasi, Kondensasi, Presipitasi, Infiltrasi."
    ]
  },
  {
    badge: "Deep Learning",
    title: "Langkah 3/4: Strategi Pembelajaran Mendalam (Deep Learning)",
    lines: [
      "\n[AKTIVITAS BELAJAR BERMAKNA]",
      "• 1. Mindful Learning: Menyesuaikan skenario dengan keunikan tingkat kesiapan/gaya belajar murid.",
      "• 2. Meaningful Learning: Melakukan eksperimen siklus air mini untuk melatih bernalar kritis & pemahaman konsep nyata.",
      "• 3. Joyful Learning: Berkolaborasi dalam membuat poster kampanye penyelamatan air secara kreatif dan menyenangkan."
    ]
  },
  {
    badge: "Asesmen",
    title: "Langkah 4/4: Asesmen Formatif & Sumatif Otomatis",
    lines: [
      "\n[ASESMEN PEMBELAJARAN MENDALAM]",
      "• Asesmen Diagnostik: Kuis lisan pemahaman awal siklus air.",
      "• Asesmen Formatif: Lembar Kerja Murid (LKPD) hasil pengamatan siklus air mini.",
      "• Asesmen Sumatif: Proyek poster kampanye penyelamatan air bersih beserta rubrik KKTP."
    ]
  }
];
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <!-- Schema Injection -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Header />
  <main>
    <Hero 
      badge="AI Pembuat RPM Terpopuler #1"
      titleHtml="Susun RPM (Rencana Pembelajaran Mendalam) <br class='hidden sm:inline' /> <span class='text-brand-primary bg-gradient-to-r from-brand-primary to-brand-dark bg-clip-text text-transparent'>Otomatis Sesuai Deep Learning</span>"
      description="Hasilkan dokumen RPM profesional, terstruktur, dan selaras dengan prinsip Pembelajaran Mendalam Kurikulum Merdeka secara praktis dalam hitungan detik."
      mapel="Ilmu Pengetahuan Alam & Sosial (IPAS)"
      kelas="Kelas 5 SD · Fase C"
      topik="Siklus Air dan Kelestarian Ekosistem"
      steps={rpmSteps}
    />

    <!-- Semantic Content Section -->
    <section class="py-20 bg-slate-50 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-16 space-y-4">
          <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight leading-tight">
            Pelopor <span class="text-brand-primary">AI Pendidikan Indonesia</span> untuk Rencana Pembelajaran Mendalam (RPM)
          </h2>
          <p class="text-lg text-gray-600 font-medium">
            Bagi guru yang biasa menyusun <strong>RPP Kurikulum Merdeka</strong> atau RPP konvensional, kini standar administrasi pembelajaran telah disempurnakan menjadi <strong>RPM (Rencana Pembelajaran Mendalam)</strong> dan <strong>RPPM</strong>. Pendekatan <strong>Pembelajaran Mendalam (Deep Learning)</strong> menekankan bahwa belajar bukan sekadar menghafal rumus atau fakta, melainkan membangun koneksi bermakna dengan kehidupan sehari-hari murid.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="space-y-6 text-gray-600 font-medium leading-relaxed font-semibold">
            <h3 class="text-2xl font-bold text-gray-900 leading-tight">
              Mengapa Menyusun RPM dengan Asisten AI Guru Indonesia?
            </h3>
            <p class="text-gray-500 font-semibold">
              Menyusun RPM yang berkualitas memerlukan integrasi matang antara Capaian Pembelajaran (CP), pemetaan <strong>Tujuan Pembelajaran (TP)</strong>, penentuan indikator asesmen diagnostik, formatif, dan sumatif, hingga perancangan <strong>Lembar Kerja Murid (LKPD)</strong>.
            </p>
            <p class="text-gray-500 font-semibold">
              Dengan menggunakan GuruDokAI, Anda dibantu memotong proses administratif yang rumit tersebut. AI kami memformulasikan skenario pembelajaran aktif yang mengedepankan kompetensi dan pembentukan karakter murid secara otomatis.
            </p>
            <div class="pt-4 border-t border-gray-200 space-y-3">
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="lucide lucide-check"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span class="text-sm font-bold text-gray-900">Merujuk ke konsep esensial kurikulum nasional terbaru 2025.</span>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="lucide lucide-check"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span class="text-sm font-bold text-gray-900">Menyediakan pemetaan alur mingguan berupa <strong>RPPM</strong> otomatis.</span>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="lucide lucide-check"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span class="text-sm font-bold text-gray-900">Terhubung langsung dengan pembuatan <a href="/modul-ajar" class="text-brand-primary hover:underline">Modul Ajar</a>, <a href="/lkpd" class="text-brand-primary hover:underline">LKPD</a>, <a href="/generator-atp" class="text-brand-primary hover:underline">ATP</a>, <a href="/generator-tp" class="text-brand-primary hover:underline">TP</a>, dan <a href="/generator-kktp" class="text-brand-primary hover:underline">KKTP</a>.</span>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-emerald-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Kurikulum Berbasis Cinta (KBC)</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                Dukungan khusus pembuatan <a href="/kurikulum-berbasis-cinta" class="text-brand-primary hover:underline">Modul Ajar KBC</a> untuk lingkungan madrasah Kemenag.
              </p>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-emerald-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Pembelajaran Mendalam</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                Strategi belajar aktif berprinsip Deep Learning untuk memicu berpikir kritis murid.
              </p>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-emerald-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-list"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Asesmen Terintegrasi</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                Desain instan instrumen Asesmen Diagnostik, Formatif, dan Sumatif yang relevan.
              </p>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-emerald-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Ekspor Word & PDF</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                Unduh file draf mentah yang sepenuhnya bisa diedit di Microsoft Word atau cetak ke PDF.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <Pricing />

    <!-- Testimonials Section -->
    <Testimonials />

    <!-- FAQ Section -->
    <FAQ faqs={rpmFaqs} />

    <!-- CTA Section -->
    <CTAFinal />
  </main>
  <Footer />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Footer from '../components/Footer.astro';

// Custom SEO Meta Data
const title = "AI Pembuat LKPD Otomatis Kurikulum Merdeka | GuruDokAI";
const description = "Buat Lembar Kerja Murid (LKPD) interaktif secara otomatis dengan kecerdasan buatan. Generator LKPD AI siap cetak lengkap dengan panduan aktivitas, soal latihan, dan kunci jawaban.";
const keywords = "ai pembuat lkpd, pembuat lkpd otomatis, generator lkpd, lembar kerja siswa pdf, buat lkpd kurikulum merdeka, lkpd interaktif ai";

// Custom FAQ for LKPD Page
const lkpdFaqs = [
  {
    question: "Apa saja jenis LKPD yang bisa dibuat oleh GuruDokAI?",
    answer: "GuruDokAI mendukung pembuatan berbagai tipe LKPD, termasuk <strong>LKPD Eksperimen Sains, LKPD Diskusi Kelompok (PBL/PjBL), LKPD Pengamatan Karakter, lembar kerja hitung, hingga LKPD membaca komprehensif bahasa</strong>."
  },
  {
    question: "Apakah LKPD yang digenerate oleh AI menyertakan kunci jawaban?",
    answer: "Ya, setiap LKPD latihan soal yang Anda buat otomatis menyertakan <strong>kunci jawaban terpisah dan rubrik penilaian</strong> di halaman akhir dokumen untuk mempermudah tugas koreksi Anda."
  },
  {
    question: "Apakah LKPD bisa didownload dalam format Word?",
    answer: "Tentu saja. Setelah proses pembuatan selesai, dokumen bisa diexport ke <strong>Microsoft Word (.docx)</strong> sehingga Anda bisa menambahkan gambar, logo sekolah, atau tabel tambahan secara manual."
  },
  {
    question: "Apakah anak murid bisa langsung mengerjakan secara online?",
    answer: "Saat ini GuruDokAI difokuskan untuk menghasilkan dokumen cetak (PDF/Word) berkualitas tinggi untuk dibagikan di kelas fisik. Fitur pengerjaan online interaktif sedang masuk dalam rencana pengembangan kami di fase berikutnya."
  },
  {
    question: "Apakah ada video panduan atau demo cara menggunakan GuruDokAI?",
    answer: "Tentu saja. Anda bisa menyaksikan <a href=\"https://www.tiktok.com/@scenecrafter/video/7655997727506976008\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-brand-primary hover:underline font-bold\">Video Demo Utama</a> dan <a href=\"https://www.tiktok.com/@scenecrafter/video/7659118261556055316\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-brand-primary hover:underline font-bold\">Eksplorasi Fitur Lengkap</a> kami di TikTok. Untuk panduan lengkap dari awal, Anda bisa menonton <a href=\"https://www.youtube.com/watch?v=cOYjV9c7IZc\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-brand-primary hover:underline font-bold\">Video Panduan Setup & Cara Pakai</a> di YouTube, serta <a href=\"https://www.tiktok.com/@scenecrafter/video/7651961072823438608\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-brand-primary hover:underline font-bold\">Video Tutorial Aplikasi Android SiAjar</a>."
  }
];

// Custom simulation steps for LKPD
const lkpdSteps = [
  {
    badge: "Identitas",
    title: "Langkah 1/4: Menentukan Identitas & Tujuan LKPD",
    lines: [
      "LEMBAR KERJA MURID (LKPD)",
      "=================================",
      "Mata Pelajaran : Bahasa Inggris",
      "Kelas / Fase   : IX (Sembilan) / D",
      "Topik          : Descriptive Text - Historical Places",
      "\n[TUJUAN PEMBELAJARAN (LEARNING OBJECTIVES)]",
      "Siswa mampu membaca dan mengidentifikasi informasi rinci, ide pokok, dan tujuan komunikatif dari teks deskriptif tentang tempat bersejarah."
    ]
  },
  {
    badge: "Aktivitas",
    title: "Langkah 2/4: Merancang Panduan Diskusi kelompok",
    lines: [
      "\n[ACTIVITY 1: GROUP DISCOVERY (20 Minutes)]",
      "Instructions for Students:",
      "1. Silakan amati gambar Candi Borobudur yang disediakan.",
      "2. Diskusikan bersama kelompokmu kata sifat (adjectives) apa saja yang cocok untuk mendeskripsikan candi tersebut (e.g. ancient, magnificent, huge).",
      "3. Tuliskan minimal 5 kata sifat dalam diagram mindmap di bawah."
    ]
  },
  {
    badge: "Soal Latihan",
    title: "Langkah 3/4: Membuat Soal Latihan & Evaluasi",
    lines: [
      "\n[ACTIVITY 2: COMPREHENSION TEST]",
      "Read the text about Borobudur Temple and answer the questions:",
      "Q1: Where is Borobudur Temple located?",
      "Q2: What is the main idea of paragraph 2?",
      "Q3: Identify three descriptive verbs used in the text.",
      "\n[RUBRIK PENILAIAN]",
      "- Jawaban Tepat & Gramatikal Benar: Nilai 4",
      "- Jawaban Tepat tapi Gramatikal Kurang: Nilai 3",
      "- Jawaban Kurang Tepat: Nilai 2"
    ]
  },
  {
    badge: "LKPD",
    title: "Langkah 4/4: Menyusun LKPD Final & Kunci Jawaban",
    lines: [
      "\n[ANSWER KEY FOR TEACHERS]",
      "A1: Borobudur Temple is located in Magelang, Central Java, Indonesia.",
      "A2: Paragraph 2 describes the architectural design and the relief panels.",
      "\n--------------------------------------------",
      "DOKUMEN LKPD DAN KUNCI JAWABAN SELESAI DIGENERATE!"
    ]
  }
];
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <Header />
  <main>
    <!-- Custom Hero for LKPD -->
    <Hero 
      badge="AI Pembuat LKPD Terpopuler #1"
      titleHtml="Buat Lembar Kerja Siswa (LKPD) <br class='hidden sm:inline' /> <span class='text-brand-primary bg-gradient-to-r from-brand-primary to-brand-dark bg-clip-text text-transparent'>Otomatis & Kreatif</span>"
      description="Hasilkan LKPD (Lembar Kerja Murid) interaktif, lembar eksperimen, dan kuis mandiri yang siap diunduh dan dicetak untuk murid Anda."
      mapel="Bahasa Inggris"
      kelas="Kelas 9 SMP · Fase D"
      topik="Descriptive Text: Describing Historical Places in Indonesia"
      steps={lkpdSteps}
    />

    <!-- Intent Rich Content Section -->
    <section class="py-20 bg-slate-50 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header Text -->
        <div class="max-w-3xl mx-auto text-center mb-16 space-y-4">
          <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight leading-tight">
            Tingkatkan Pemahaman Murid dengan <span class="text-brand-primary">LKPD Interaktif AI</span>
          </h2>
          <p class="text-lg text-gray-600 font-medium">
            Lembar Kerja Murid yang berkualitas membantu menguji pemahaman konsep murid secara aktif. Dengan AI Pembuat LKPD GuruDokAI, Anda bisa menghasilkan lembar kerja berkualitas tinggi lengkap dengan panduan praktikum, instruksi diskusi, latihan soal, dan kunci jawaban dalam sekejap.
          </p>
        </div>

        <!-- 2 Column Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          
          <!-- Column 1: Informational Text -->
          <div class="space-y-6 text-gray-600 font-medium leading-relaxed font-semibold">
            <h3 class="text-2xl font-bold text-gray-900 leading-tight">
              Mengapa Guru Membutuhkan Generator LKPD Otomatis?
            </h3>
            <p class="text-gray-500 font-semibold">
              Seringkali guru kehabisan ide untuk membuat variasi tugas yang menarik bagi siswa. Membuat soal latihan secara manual juga memerlukan waktu ekstra untuk memikirkan tingkat kesulitan (LOTS/HOTS).
            </p>
            <p class="text-gray-500 font-semibold">
              Kecerdasan buatan GuruDokAI dirancang khusus untuk memformulasikan tipe aktivitas pembelajaran yang bervariasi. Mulai dari tugas mencocokkan kata, eksperimen sains mandiri, hingga lembar kerja diskusi kasus nyata sosial.
            </p>
            <div class="pt-4 border-t border-gray-200 space-y-3">
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="lucide lucide-check"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span class="text-sm font-bold text-gray-900">Pembagian Tipe Tugas: Eksperimen, diskusi, analisis, & tugas mandiri.</span>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="lucide lucide-check"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span class="text-sm font-bold text-gray-900">Kunci Jawaban & Rubrik: Membantu mempermudah koreksi nilai murid.</span>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="lucide lucide-check"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span class="text-sm font-bold text-gray-900">Terintegrasi Penuh: Hasilkan <a href="/ai-pembuat-rpp/" class="text-brand-primary hover:underline">RPP</a>, <a href="/generator-modul-ajar/" class="text-brand-primary hover:underline">Modul Ajar</a>, dan <a href="/generator-atp/" class="text-brand-primary hover:underline">ATP</a> yang saling selaras secara instan.</span>
              </div>
            </div>
          </div>

          <!-- Column 2: Specific Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            
            <!-- Card 1 -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-emerald-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-list"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Instruksi Terstruktur</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                Langkah-langkah pengerjaan tugas ditulis secara runtut dan mudah dipahami oleh murid secara mandiri.
              </p>
            </div>

            <!-- Card 2 -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-emerald-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-key"><circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 3 3H22v-3z"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Dengan Kunci Jawaban</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                Setiap lembar latihan langsung dilengkapi lembar kunci jawaban terpisah di halaman akhir.
              </p>
            </div>

            <!-- Card 3 -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-emerald-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Soal HOTS & Variatif</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                Hasilkan soal tingkat analisis tinggi (Higher Order Thinking Skills) untuk memicu nalar siswa.
              </p>
            </div>

            <!-- Card 4 -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-emerald-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-edit-3"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Mudah Diedit Kembali</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                Unduh dalam format Word (.docx) agar Anda dapat menyesuaikan layout, nama sekolah, atau menambahkan gambar.
              </p>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- Visual 3-Steps Guide -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
          <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight leading-tight">
            Cara Membuat LKPD Otomatis dengan AI
          </h2>
          <p class="text-lg text-gray-600 font-medium">
            Hanya butuh 3 langkah instan untuk menyusun lembar aktivitas belajar yang menarik.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 relative">
          <!-- Step 1 -->
          <div class="text-center space-y-4 relative">
            <div class="w-16 h-16 rounded-2xl bg-brand-primary text-white font-extrabold text-2xl flex items-center justify-center mx-auto shadow-lg shadow-brand-primary/20">
              1
            </div>
            <h3 class="text-xl font-bold text-gray-900">Masukkan Kompetensi Dasar</h3>
            <p class="text-sm sm:text-base text-gray-500 leading-relaxed font-semibold px-4">
              Pilih kelas, materi pelajaran, dan masukkan topik utama yang sedang dipelajari murid Anda.
            </p>
          </div>

          <!-- Step 2 -->
          <div class="text-center space-y-4 relative">
            <div class="w-16 h-16 rounded-2xl bg-brand-primary text-white font-extrabold text-2xl flex items-center justify-center mx-auto shadow-lg shadow-brand-primary/20">
              2
            </div>
            <h3 class="text-xl font-bold text-gray-900">Proses Generate LKPD</h3>
            <p class="text-sm sm:text-base text-gray-500 leading-relaxed font-semibold px-4">
              AI GuruDokAI memformulasikan tugas kelompok, tes latihan, kriteria rubrik, hingga lembar kunci jawaban.
            </p>
          </div>

          <!-- Step 3 -->
          <div class="text-center space-y-4 relative">
            <div class="w-16 h-16 rounded-2xl bg-brand-primary text-white font-extrabold text-2xl flex items-center justify-center mx-auto shadow-lg shadow-brand-primary/20">
              3
            </div>
            <h3 class="text-xl font-bold text-gray-900">Download Dokumen Word/PDF</h3>
            <p class="text-sm sm:text-base text-gray-500 leading-relaxed font-semibold px-4">
              Review hasilnya di layar, sesuaikan isinya bila diperlukan, lalu simpan menjadi file siap cetak.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- Pricing Component -->
    <Pricing />

    <!-- Testimonials Component -->
    <Testimonials />

    <!-- FAQ Component with Custom FAQs -->
    <FAQ faqs={lkpdFaqs} />

    <!-- CTA Final -->
    <CTAFinal 
      title="Buat Lembar Kerja Siswa Menarik dalam Hitungan Detik"
      description="Mulailah mendesain lembar kerja siswa yang kreatif dan terstruktur bersama GuruDokAI sekarang."
    />
  </main>
  <Footer />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Footer from '../components/Footer.astro';

// Custom SEO Meta Data
const title = "Panduan & Format Modul Ajar Kurikulum Merdeka | GuruDokAI";
const description = "Pelajari susunan dan komponen resmi Modul Ajar Kurikulum Merdeka Kemendikdasmen. Buat Modul Ajar lengkap dengan bahan bacaan dan LKPD menggunakan AI.";
const keywords = "modul ajar kurikulum merdeka, generator modul ajar, pembuat modul ajar otomatis, rpp kurikulum merdeka, rpp otomatis, lkpd murid, kbc kemenag";

const pageUrl = "https://gurudokai.supathub.my.id/modul-ajar";

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Beranda",
      "item": "https://gurudokai.supathub.my.id/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "AI Pembuat Modul Ajar",
      "item": pageUrl
    }
  ]
};

// Custom FAQ for Modul Ajar
const modulFaqs = [
  {
    question: "Apa perbedaan RPP dan Modul Ajar?",
    answer: "<strong>Modul Ajar</strong> pada dasarnya adalah <strong>RPP yang lebih lengkap</strong>. Modul Ajar memuat rincian materi pembelajaran, lembar aktivitas murid (LKPD), media pembelajaran, serta instrumen asesmen yang menyeluruh untuk memandu proses belajar mengajar secara mandiri."
  },
  {
    question: "Bagaimana GuruDokAI menyusun Modul Ajar Kurikulum Merdeka?",
    answer: "GuruDokAI menganalisis komponen utama: Informasi Umum, Komponen Inti (Tujuan Pembelajaran, Pertanyaan Pemantik, Kegiatan Pembelajaran), serta Lampiran (LKPD, Glosarium, Bahan Bacaan Guru & Murid) agar sesuai dengan panduan resmi Kemendikbudristek."
  },
  {
    question: "Apakah modul ajar yang dihasilkan mendukung model pembelajaran aktif?",
    answer: "Ya, betul sekali. AI GuruDokAI merekomendasikan berbagai model pembelajaran inovatif seperti Project-Based Learning (PjBL), Problem-Based Learning (PBL), Discovery Learning, serta pendekatan <strong>Pembelajaran Mendalam (Deep Learning)</strong>."
  },
  {
    question: "Apakah bisa membuat Modul Ajar KBC (Kurikulum Berbasis Cinta)?",
    answer: "Tentu saja. Guru madrasah di bawah naungan Kemenag (MI, MTs, MA) dapat memilih opsi penyusunan Modul Ajar berbasis <strong>Kurikulum Berbasis Cinta (KBC)</strong> secara praktis."
  }
];

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": modulFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer.replace(/<\/?[^>]+(>|$)/g, "")
    }
  }))
};

const modulSteps = [
  {
    badge: "Info Modul",
    title: "Langkah 1/5: Mengisi Informasi Umum Modul",
    lines: [
      "MODUL AJAR KURIKULUM MERDEKA",
      "============================",
      "Mata Pelajaran : Informatika",
      "Kelas / Fase   : VII / D",
      "Elemen         : Algoritma dan Pemrograman",
      "Alokasi Waktu  : 2 JP (2 x 40 Menit)",
      "\n[KOMPETENSI AWAL]",
      "Murid memahami konsep urutan instruksi logis dalam kehidupan sehari-hari."
    ]
  },
  {
    badge: "Tujuan",
    title: "Langkah 2/5: Menentukan TP & Pertanyaan Pemantik",
    lines: [
      "\n[TUJUAN PEMBELAJARAN (TP)]",
      "• Murid mampu merancang langkah-langkah algoritma sederhana (pseudocode) untuk memecahkan masalah.",
      "\n[PERTANYAAN PEMANTIK]",
      "Bagaimana komputer bisa mengerti instruksi yang kita berikan?"
    ]
  },
  {
    badge: "Langkah Ajar",
    title: "Langkah 3/5: Menyusun Skenario Kegiatan Belajar",
    lines: [
      "\n[KEGIATAN INTI PEMBELAJARAN]",
      "• Pembukaan: Orientasi masalah robot pelari labirin.",
      "• Kegiatan: Murid menulis instruksi maju, belok kanan/kiri di kertas grid.",
      "• Penutup: Refleksi metakognitif kelompok tentang tingkat kejelasan instruksi."
    ]
  },
  {
    badge: "LKPD AI",
    title: "Langkah 4/5: Menyertakan Lembar Kerja Murid & Asesmen",
    lines: [
      "\n[LAMPIRAN MODUL AJAR]",
      "• LKPD: Studi kasus membuat instruksi resep membuat teh manis secara prosedural.",
      "• Asesmen Formatif: Rubrik penilaian keterbacaan pseudocode berdasarkan rubrik KKTP."
    ]
  },
  {
    badge: "Selesai",
    title: "Langkah 5/5: Dokumen Siap Unduh",
    lines: [
      "\n[HASIL GENERATE MODUL AJAR LENGKAP]",
      "• Informasi Umum: Lengkap (Sarpras, Target Murid, Model Belajar).",
      "• Komponen Inti & Lampiran: Siap pakai.",
      "\n--------------------------------------------",
      "DOKUMEN MODUL AJAR LENGKAP SELESAI DIGENERATE!"
    ]
  }
];
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <!-- Schema Injection -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Header />
  <main>
    <Hero 
      badge="AI Generator Modul Ajar #1"
      titleHtml="Pembuat Modul Ajar Kurikulum Merdeka <br class='hidden sm:inline' /> <span class='text-brand-primary bg-gradient-to-r from-brand-primary to-brand-dark bg-clip-text text-transparent'>Otomatis & Lengkap Lampiran</span>"
      description="Hasilkan draf Modul Ajar Kurikulum Merdeka terlengkap dalam hitungan detik. Cukup masukkan mata pelajaran dan topik, AI kami akan mengurus sisanya."
      mapel="Informatika"
      kelas="Kelas 7 SMP · Fase D"
      topik="Algoritma & Pemrograman (Pseudocode)"
      steps={modulSteps}
    />

    <!-- Semantic Content Section -->
    <section class="py-20 bg-slate-50 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-16 space-y-4">
          <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight leading-tight">
            Hemat Waktu Administrasi Guru Dengan <span class="text-brand-primary">Generator Modul Ajar AI</span>
          </h2>
          <p class="text-lg text-gray-600 font-medium">
            Menyusun <strong>Modul Ajar Kurikulum Merdeka</strong> secara manual sering kali menguras energi guru. Dokumen tebal yang menuntut detail sarana prasarana, model pembelajaran, LKPD, bahan bacaan, hingga glosarium dapat diselesaikan secara instan menggunakan asisten AI Guru Indonesia terpercaya.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="space-y-6 text-gray-600 font-medium leading-relaxed font-semibold">
            <h3 class="text-2xl font-bold text-gray-900 leading-tight">
              Kelebihan Pembuatan Modul Ajar Otomatis
            </h3>
            <p class="text-gray-500 font-semibold">
              Platform GuruDokAI secara mekanis menyelaraskan rumusan <strong>Tujuan Pembelajaran (TP)</strong>, alur <strong>ATP</strong>, materi ajar inti, lembar kerja <strong>LKPD</strong>, rencana <strong>RPM (Rencana Pembelajaran Mendalam)</strong>, hingga instrumen evaluasi <strong>KKTP</strong>.
            </p>
            <p class="text-gray-500 font-semibold">
              Hal ini memastikan seluruh dokumen perencanaan Anda sinkron dan memiliki benang merah yang jelas dari tujuan hingga asesmen akhir murid.
            </p>
            <div class="pt-4 border-t border-gray-200 space-y-3">
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="lucide lucide-check"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span class="text-sm font-bold text-gray-900">Menyusun materi ajar sistematis berlandaskan prinsip Deep Learning.</span>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="lucide lucide-check"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span class="text-sm font-bold text-gray-900">Mendukung opsi Kurikulum Berbasis Cinta (KBC) untuk sekolah madrasah Kemenag.</span>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="lucide lucide-check"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span class="text-sm font-bold text-gray-900">Hasil dokumen bisa langsung diunduh ke format Microsoft Word yang sepenuhnya dapat diedit.</span>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-orange-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Komponen Lengkap</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                Memenuhi seluruh bagian wajib Modul Ajar (Informasi Umum, Inti, Lampiran) sesuai standar resmi.
              </p>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-orange-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Lampiran LKPD Otomatis</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                Setiap modul langsung dilengkapi dengan <a href="/lkpd" class="text-brand-primary hover:underline">Lembar Kerja Murid (LKPD)</a> yang relevan dengan topik.
              </p>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-orange-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check-square"><polyline points="9 11 12 14 22 4"/><path d="M21-12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Asesmen Pembelajaran</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                Instrumen Asesmen Diagnostik, Formatif, dan Sumatif dirancang berurutan bersama kriteria kelulusan.
              </p>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-premium hover-scale">
              <div class="w-10 h-10 rounded-lg bg-orange-50 text-brand-primary flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-graduation-cap"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"/></svg>
              </div>
              <h4 class="text-base font-extrabold text-gray-900 mb-2">Kurikulum Berbasis Cinta (KBC)</h4>
              <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-semibold">
                Skenario madrasah khusus untuk MI, MTs, dan MA berbasis pendekatan <a href="/kbc" class="text-brand-primary hover:underline">Modul Ajar KBC</a>.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <Pricing />

    <!-- Testimonials Section -->
    <Testimonials />

    <!-- FAQ Section -->
    <FAQ faqs={modulFaqs} />

    <!-- CTA Section -->
    <CTAFinal />
  </main>
  <Footer />
</BaseLayout>

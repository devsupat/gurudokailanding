---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = "Rekomendasi Aplikasi Digital Guru Indonesia | GuruDokAI";
const description = "Daftar aplikasi digital untuk membantu guru Indonesia menyusun modul ajar dan administrasi pembelajaran, lengkap dengan fungsi, platform, dan biaya.";
const keywords = "rekomendasi aplikasi guru, aplikasi AI guru, aplikasi administrasi guru, secure exam browser, SiAjar, Rekap Guru, SiUjian, GuruDokAI";

const canonicalUrl = "https://gurudokai.supathub.my.id/rekomendasi/";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Beranda",
      "item": "https://gurudokai.supathub.my.id/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Rekomendasi Aplikasi Guru",
      "item": canonicalUrl
    }
  ]
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Rekomendasi Aplikasi Digital untuk Guru Indonesia",
  "description": "Kumpulan aplikasi pilihan pendukung tugas mengajar dan administrasi guru Indonesia.",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "GuruDok AI",
      "url": "https://gurudokai.supathub.my.id/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "SiAjar",
      "url": "https://gurudokai.supathub.my.id/rekomendasi/siajar/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Rekap Guru",
      "url": "https://gurudokai.supathub.my.id/rekomendasi/rekap-guru/"
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": "SiUjian",
      "url": "https://gurudokai.supathub.my.id/rekomendasi/siujian/"
    }
  ]
};

const apps = [
  {
    name: "GuruDok AI",
    badge: "Utama / Desktop & Web",
    description: "Pelopor asisten AI guru Indonesia untuk menyusun RPP Kurikulum Merdeka, RPM (Rencana Pembelajaran Mendalam), Modul Ajar, LKPD Interaktif, dan Bank Soal otomatis.",
    link: "/",
    linkText: "Buka Halaman GuruDok AI",
    isExternal: false,
    featured: true,
    platform: "Windows Desktop & Web"
  },
  {
    name: "SiAjar",
    badge: "Rekomendasi / Android",
    description: "Asisten AI untuk membuat Modul Ajar Kurikulum 2025 dalam 60 detik, dokumen administrasi guru (TP, ATP, KKTP, Prota, Prosem), serta dilengkapi berbagai fitur Alat Bantu PDF.",
    link: "/rekomendasi/siajar/",
    linkText: "Baca Ulasan & Detail SiAjar",
    isExternal: false,
    featured: true,
    platform: "Android Mobile"
  },
  {
    name: "Rekap Guru",
    badge: "Rekomendasi / Android",
    description: "Aplikasi pendukung administrasi kelas untuk mengelola siswa, absensi, nilai, jurnal, laporan PDF dan Excel, backup data, serta Bot WhatsApp Otomatis sebagai langganan tersendiri.",
    link: "/rekomendasi/rekap-guru/",
    linkText: "Baca Informasi Rekap Guru",
    isExternal: false,
    featured: true,
    platform: "Android Mobile"
  },
  {
    name: "SiUjian",
    badge: "Rekomendasi / Android",
    description: "Secure Exam Browser untuk menjalankan ujian online dalam mode terkunci menggunakan token, sistem penalti, dan monitor ujian tanpa menjadi sistem CBT atau LMS.",
    link: "/rekomendasi/siujian/",
    linkText: "Baca Informasi SiUjian",
    isExternal: false,
    featured: true,
    platform: "Android Mobile"
  }
];
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <Header />

  <main class="pt-24 pb-20 bg-slate-50 min-h-screen">
    <!-- Hero Header -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center relative">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200/80 mb-6 shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="lucide lucide-layout-grid"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
        <span>Pusat Rekomendasi Aplikasi Guru</span>
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 tracking-tight leading-tight mb-6">
        Rekomendasi Aplikasi Digital untuk <span class="bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700 bg-clip-text text-transparent">Guru Indonesia</span>
      </h1>
      <p class="max-w-3xl mx-auto text-lg text-slate-600 font-medium leading-relaxed">
        Kumpulan informasi aplikasi dan teknologi kecerdasan buatan (AI) untuk membantu guru menghemat waktu administrasi serta menyiapkan pembelajaran.
      </p>
    </div>

    <!-- App Cards Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {apps.map((app) => (
          <div class={`bg-white/90 backdrop-blur-md border rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 ${app.featured ? 'border-emerald-200 shadow-xl shadow-emerald-900/5 hover:border-emerald-400 hover:shadow-2xl hover:shadow-emerald-900/10 ring-1 ring-emerald-500/10' : 'border-slate-200/90 shadow-lg hover:border-slate-300'}`}>
            <div>
              <div class="flex items-center justify-between mb-5">
                <span class={`px-3.5 py-1 rounded-full text-xs font-bold ${app.featured ? 'bg-emerald-50 text-emerald-700 border border-emerald-200/80 shadow-xs' : 'bg-slate-100 text-slate-600 border border-slate-200'}`}>
                  {app.badge}
                </span>
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider bg-slate-100/80 px-2.5 py-0.5 rounded-md">{app.platform}</span>
              </div>

              <h2 class="text-2xl font-extrabold text-slate-900 mb-3 tracking-tight">{app.name}</h2>
              <p class="text-slate-600 text-sm leading-relaxed font-medium mb-8">
                {app.description}
              </p>
            </div>

            <div>
              {app.isExternal ? (
                <a 
                  href={app.link} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center w-full px-5 py-3 text-sm font-bold text-slate-800 bg-slate-100 hover:bg-emerald-600 hover:text-white rounded-2xl transition-all duration-200 gap-2 shadow-sm"
                >
                  <span>{app.linkText}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
                </a>
              ) : (
                <a 
                  href={app.link} 
                  class={`inline-flex items-center justify-center w-full px-5 py-3 text-sm font-bold rounded-2xl transition-all duration-200 gap-2 ${app.link.startsWith('#') ? 'bg-slate-100 text-slate-400 cursor-not-allowed' : 'text-white bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 shadow-md shadow-emerald-600/20 hover:shadow-lg hover:shadow-emerald-600/30'}`}
                >
                  <span>{app.linkText}</span>
                  {!app.link.startsWith('#') && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  )}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

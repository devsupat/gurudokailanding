---
---
<section class="relative pt-28 pb-20 md:pt-36 md:pb-28 bg-gradient-to-b from-brand-light/80 via-brand-light/20 to-white overflow-hidden">
  <!-- Decorative background shapes -->
  <div class="absolute top-0 right-0 -z-10 w-96 h-96 bg-brand-medium/10 rounded-full blur-3xl opacity-60 transform translate-x-20 -translate-y-20"></div>
  <div class="absolute bottom-0 left-0 -z-10 w-80 h-80 bg-brand-light rounded-full blur-2xl opacity-80 transform -translate-x-20 translate-y-20"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Left Content -->
      <div class="lg:col-span-7 text-center lg:text-left space-y-6">
        <!-- Premium Badge -->
        <div class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-brand-primary/10 border border-brand-primary/20 text-brand-primary text-xs sm:text-sm font-bold tracking-wide uppercase">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275Z"/><path d="m5 3 1 2.5L8.5 6 6 7 5 9.5 4 7 1.5 6 4 5.5Z"/><path d="m19 17 1 2.5 2.5.5-2.5 1-1 2.5-1-2.5-2.5-1 2.5-1Z"/></svg>
          AI Asisten Guru Indonesia #1
        </div>

        <!-- Heading -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-gray-900 tracking-tight leading-tight">
          Akhiri Lembur Bikin RPP. <br />
          <span class="text-brand-primary bg-gradient-to-r from-brand-primary to-brand-dark bg-clip-text text-transparent">GuruDokAI</span> Selesaikan dalam 2 Menit.
        </h1>

        <!-- Subheading / description -->
        <p class="text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto lg:mx-0 font-medium">
          RPP, Modul Ajar, Bank Soal HOTS, dan ATP otomatis dibuat khusus sesuai Kurikulum Merdeka. Mulai dari Rp 19.000/bulan.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a 
            href="https://lynk.id/oghiezr/zxjox857nz71" 
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-brand-primary hover:bg-brand-dark rounded-full shadow-lg shadow-brand-primary/20 hover-scale"
          >
            Coba Sekarang – Mulai 19rb
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a 
            href="#fitur" 
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-bold text-gray-700 bg-white hover:bg-gray-50 border border-gray-200 rounded-full shadow-sm hover-scale"
          >
            Lihat Fitur
          </a>
        </div>

        <!-- Social Proof -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3">
          <div class="flex -space-x-2">
            <span class="inline-block h-9 w-9 rounded-full ring-2 ring-white bg-brand-primary text-white flex items-center justify-center font-bold text-xs">G</span>
            <span class="inline-block h-9 w-9 rounded-full ring-2 ring-white bg-green-500 text-white flex items-center justify-center font-bold text-xs">U</span>
            <span class="inline-block h-9 w-9 rounded-full ring-2 ring-white bg-emerald-600 text-white flex items-center justify-center font-bold text-xs">R</span>
            <span class="inline-block h-9 w-9 rounded-full ring-2 ring-white bg-teal-600 text-white flex items-center justify-center font-bold text-xs">U</span>
          </div>
          <div class="text-sm font-semibold text-gray-600 text-center sm:text-left">
            <span class="text-brand-primary font-bold">1.500+ Guru</span> di Indonesia telah mengakhiri lembur mingguan mereka!
          </div>
        </div>
      </div>

      <!-- Right Dashboard Image -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-[500px] lg:max-w-none">
          <!-- Decorative glow -->
          <div class="absolute inset-0 bg-brand-primary/20 rounded-3xl blur-2xl transform rotate-3 scale-95 -z-10"></div>
          
          <!-- Image Wrapper with high quality shadow and slight tilt -->
          <div class="bg-white p-2 rounded-2xl shadow-premium-lg border border-gray-100 transform hover:rotate-0 transition-transform duration-500 lg:rotate-1">
            <img 
              src="/dashboard-screenshot.png" 
              alt="GuruDokAI Application Dashboard Screenshot" 
              class="w-full h-auto rounded-xl object-cover" 
              loading="eager"
              width="1000"
              height="650"
            />
          </div>

          <!-- Extra floating card badge -->
          <div class="absolute -bottom-6 -left-6 bg-white p-4 rounded-xl shadow-premium border border-gray-50 flex items-center gap-3 hover-scale hidden sm:flex">
            <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center text-brand-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check-circle-2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <div>
              <p class="text-xs text-gray-400 font-medium">Kurikulum Merdeka</p>
              <p class="text-sm font-extrabold text-gray-900">100% Sesuai Standar</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

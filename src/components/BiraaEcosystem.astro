---
---

<section class="py-20 bg-slate-900 text-white relative overflow-hidden border-t border-slate-800">
  <!-- Subtle background ambient glow -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-brand-primary/10 rounded-full blur-3xl opacity-50 pointer-events-none"></div>
  <div class="absolute bottom-0 left-1/4 w-80 h-80 bg-emerald-600/10 rounded-full blur-3xl opacity-40 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <header class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold bg-brand-primary/15 text-brand-primary border border-brand-primary/30 uppercase tracking-wider">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-grid"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
        <span>Aplikasi BiraaStudio</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
        Bangun Ekosistem Pendidikan Digital
      </h2>
      <p class="text-lg text-slate-300 font-medium">
        BiraaStudio mengembangkan aplikasi pendidikan modern untuk guru, sekolah, dan murid.
      </p>
      <p class="text-sm font-semibold text-brand-primary/90 italic pt-1">
        "Satu app. Satu masalah. Diselesaikan dengan sangat baik."
      </p>
    </header>

    <!-- Featured App Container -->
    <div class="max-w-3xl mx-auto">
      <div class="bg-slate-800/80 border border-slate-700 hover:border-brand-primary/40 rounded-3xl p-6 sm:p-8 shadow-2xl backdrop-blur-sm transition-all">
        
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pb-6 border-b border-slate-700/80">
          
          <!-- App Identity -->
          <div class="flex items-center gap-4">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-brand-primary to-emerald-700 flex items-center justify-center text-white font-extrabold text-2xl shadow-lg shadow-brand-primary/20 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-check-2"><path d="M4 22h14a2 2 0 0 0 2-2V7.5L14.5 2H6a2 2 0 0 0-2 2v4"/><polyline points="14 2 14 8 20 8"/><path d="m3 15 2 2 4-4"/></svg>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h3 class="text-2xl font-extrabold text-white">SiUjian</h3>
                <span class="px-2 py-0.5 text-[10px] font-extrabold uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 rounded-md">Featured App</span>
              </div>
              <p class="text-xs text-slate-400 font-semibold mt-0.5">Developer: <span class="text-slate-200">BiraaStudio</span></p>
            </div>
          </div>

          <!-- Primary App CTA -->
          <a 
            href="https://play.google.com/store/apps/dev?id=8704276077631485252" 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label="Lihat aplikasi SiUjian oleh BiraaStudio di Google Play"
            class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-bold text-slate-900 bg-brand-primary hover:bg-emerald-400 rounded-full shadow-lg shadow-brand-primary/20 transition-all hover-scale"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="lucide lucide-play"><polygon points="6 3 20 12 6 21 6 3"/></svg>
            <span>Lihat di Google Play</span>
          </a>

        </div>

        <!-- App Description & Verified Metrics -->
        <div class="pt-6 space-y-6">
          <p class="text-slate-300 text-base leading-relaxed font-medium">
            Aplikasi ujian online berbasis web untuk guru dan siswa. Dirancang praktis untuk menyelenggarakan ujian sekolah, kuis harian, serta evaluasi belajar secara aman dan efisien.
          </p>

          <!-- Verified Google Play Details Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
            
            <!-- Rating & Reviews -->
            <div class="bg-slate-900/60 border border-slate-700/60 rounded-xl p-3 text-center">
              <div class="flex items-center justify-center gap-1 text-amber-400 font-bold text-sm">
                <span>3,8</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-amber-400"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <div class="text-[11px] text-slate-400 font-semibold mt-1">54 ulasan</div>
            </div>

            <!-- Downloads -->
            <div class="bg-slate-900/60 border border-slate-700/60 rounded-xl p-3 text-center">
              <div class="text-white font-extrabold text-sm">5 rb+</div>
              <div class="text-[11px] text-slate-400 font-semibold mt-1">Downloads</div>
            </div>

            <!-- Content Rating -->
            <div class="bg-slate-900/60 border border-slate-700/60 rounded-xl p-3 text-center">
              <div class="text-white font-extrabold text-sm">Rating 3+</div>
              <div class="text-[11px] text-slate-400 font-semibold mt-1">Semua Umur</div>
            </div>

            <!-- In-App Purchase -->
            <div class="bg-slate-900/60 border border-slate-700/60 rounded-xl p-3 text-center">
              <div class="text-emerald-400 font-bold text-xs truncate">In-App Purchase</div>
              <div class="text-[11px] text-slate-400 font-semibold mt-1">Pembelian dlm App</div>
            </div>

          </div>
        </div>

      </div>

      <!-- Developer All-Apps CTA Link -->
      <div class="mt-8 text-center">
        <a 
          href="https://play.google.com/store/apps/dev?id=8704276077631485252" 
          target="_blank" 
          rel="noopener noreferrer"
          aria-label="Lihat semua aplikasi BiraaStudio di Google Play"
          class="inline-flex items-center gap-2 text-sm font-bold text-slate-300 hover:text-brand-primary transition-colors group"
        >
          <span>Lihat semua aplikasi BiraaStudio di Google Play</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>

    </div>

  </div>
</section>

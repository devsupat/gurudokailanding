---
---

<section class="py-24 bg-slate-950 text-white relative overflow-hidden border-t border-slate-800/80">
  <!-- Subtle background ambient glows & grid overlay -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(16,185,129,0.15),rgba(255,255,255,0))] pointer-events-none"></div>
  <div class="absolute top-1/4 -right-20 w-96 h-96 bg-emerald-500/10 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-10 -left-20 w-96 h-96 bg-teal-500/10 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-sky-500/5 rounded-full blur-[140px] pointer-events-none"></div>
  
  <!-- Subtle Background Grid Pattern -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b15_1px,transparent_1px),linear-gradient(to_bottom,#1e293b15_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <header class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold bg-slate-900/90 text-emerald-400 border border-emerald-500/30 shadow-[0_0_20px_rgba(16,185,129,0.15)] uppercase tracking-wider backdrop-blur-md">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-grid text-emerald-400"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
        <span>Aplikasi BiraaStudio</span>
      </div>
      
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-tight text-white">
        Bangun Ekosistem <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">Pendidikan Digital</span>
      </h2>
      
      <p class="text-lg text-slate-300 font-medium max-w-2xl mx-auto leading-relaxed">
        BiraaStudio mengembangkan aplikasi pendidikan modern untuk guru, sekolah, dan murid.
      </p>
      
      <div class="pt-1">
        <span class="inline-block text-sm font-semibold text-emerald-400/90 bg-emerald-950/40 border border-emerald-500/20 px-4 py-1.5 rounded-xl italic">
          "Satu app. Satu masalah. Diselesaikan dengan sangat baik."
        </span>
      </div>
    </header>

    <!-- Featured Apps Container Grid -->
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">

      <!-- App Card 1: SiAjar -->
      <div class="group relative bg-gradient-to-b from-slate-900/90 via-slate-900/80 to-slate-950/90 border border-slate-800 hover:border-emerald-500/40 rounded-3xl p-7 shadow-2xl backdrop-blur-xl transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_50px_rgba(16,185,129,0.15)] flex flex-col justify-between overflow-hidden">
        <!-- Top accent gradient sheen line -->
        <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-emerald-500 via-teal-400 to-emerald-600 opacity-80 group-hover:opacity-100 transition-opacity"></div>
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-emerald-500/10 rounded-full blur-2xl group-hover:bg-emerald-500/20 transition-all pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between gap-4 pb-5 border-b border-slate-800">
            <div class="flex items-center gap-3.5">
              <div class="w-13 h-13 rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-600 flex items-center justify-center text-white font-extrabold text-xl shadow-[0_0_20px_rgba(16,185,129,0.35)] shrink-0 group-hover:scale-105 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275Z"/></svg>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-xl font-extrabold text-white tracking-tight">SiAjar</h3>
                  <span class="px-2.5 py-0.5 text-[10px] font-extrabold uppercase bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 rounded-md tracking-wider">Android AI</span>
                </div>
                <p class="text-xs text-slate-400 font-medium mt-1">Developer: <span class="text-slate-200 font-semibold">BiraaStudio</span></p>
              </div>
            </div>
          </div>

          <div class="pt-5 space-y-5">
            <p class="text-slate-300 text-sm leading-relaxed font-normal">
              Asisten AI untuk Guru Indonesia menyusun Modul Ajar (RPP) Kurikulum 2025 dalam 60 detik, dokumen administrasi kelas, serta dilengkapi berbagai fitur Alat Bantu PDF.
            </p>

            <div class="grid grid-cols-2 gap-2.5 pt-1 text-xs">
              <div class="bg-slate-950/70 border border-slate-800/80 group-hover:border-emerald-500/20 rounded-xl p-3 text-center transition-colors">
                <div class="text-emerald-400 font-extrabold text-xs">Kurikulum 2025</div>
                <div class="text-[10px] text-slate-400 font-medium mt-0.5">Standar CP Official</div>
              </div>
              <div class="bg-slate-950/70 border border-slate-800/80 group-hover:border-emerald-500/20 rounded-xl p-3 text-center transition-colors">
                <div class="text-white font-extrabold text-xs">60 Detik</div>
                <div class="text-[10px] text-slate-400 font-medium mt-0.5">Generasi Instan</div>
              </div>
            </div>
          </div>
        </div>

        <div class="pt-6 flex flex-col sm:flex-row gap-2.5">
          <a 
            href="/rekomendasi/siajar/"
            class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 rounded-xl shadow-lg shadow-emerald-950/50 hover:shadow-emerald-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
          >
            <span>Baca Ulasan Lengkap</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a 
            href="https://play.google.com/store/apps/details?id=com.biraastudio.siajar" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-bold text-slate-300 hover:text-white bg-slate-950/80 hover:bg-slate-800/80 border border-slate-700/80 hover:border-slate-600 rounded-xl shadow-sm hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-emerald-400"><polygon points="6 3 20 12 6 21 6 3"/></svg>
            <span>Google Play</span>
          </a>
        </div>
      </div>

      <!-- App Card 2: Rekap Guru -->
      <div class="group relative bg-gradient-to-b from-slate-900/90 via-slate-900/80 to-slate-950/90 border border-slate-800 hover:border-teal-500/40 rounded-3xl p-7 shadow-2xl backdrop-blur-xl transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_50px_rgba(20,184,166,0.15)] flex flex-col justify-between overflow-hidden">
        <!-- Top accent gradient sheen line -->
        <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-teal-500 via-cyan-400 to-teal-600 opacity-80 group-hover:opacity-100 transition-opacity"></div>
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-teal-500/10 rounded-full blur-2xl group-hover:bg-teal-500/20 transition-all pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between gap-4 pb-5 border-b border-slate-800">
            <div class="flex items-center gap-3.5">
              <div class="w-13 h-13 rounded-2xl bg-gradient-to-br from-teal-400 to-cyan-600 flex items-center justify-center text-white shadow-[0_0_20px_rgba(20,184,166,0.35)] shrink-0 group-hover:scale-105 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="m16 11 2 2 4-4"/></svg>
              </div>
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-xl font-extrabold text-white tracking-tight">Rekap Guru</h3>
                  <span class="px-2.5 py-0.5 text-[10px] font-extrabold uppercase bg-teal-500/15 text-teal-300 border border-teal-500/30 rounded-md tracking-wider">Administrasi Kelas</span>
                </div>
                <p class="text-xs text-slate-400 font-medium mt-1">Aplikasi mobile untuk guru</p>
              </div>
            </div>
          </div>

          <div class="pt-5 space-y-5">
            <p class="text-slate-300 text-sm leading-relaxed font-normal">
              Membantu guru mengelola siswa, absensi, nilai, jurnal, laporan, dan backup dari HP. Bot WhatsApp Otomatis tersedia sebagai langganan tersendiri.
            </p>

            <div class="grid grid-cols-2 gap-2.5 pt-1 text-xs">
              <div class="bg-slate-950/70 border border-slate-800/80 group-hover:border-teal-500/20 rounded-xl p-3 text-center transition-colors">
                <div class="text-teal-400 font-extrabold text-xs">PDF & Excel</div>
                <div class="text-[10px] text-slate-400 font-medium mt-0.5">Format Laporan</div>
              </div>
              <div class="bg-slate-950/70 border border-slate-800/80 group-hover:border-teal-500/20 rounded-xl p-3 text-center transition-colors">
                <div class="text-white font-extrabold text-xs">Bot WhatsApp</div>
                <div class="text-[10px] text-slate-400 font-medium mt-0.5">Langganan Terpisah</div>
              </div>
            </div>
          </div>
        </div>

        <div class="pt-6 flex flex-col sm:flex-row gap-2.5">
          <a
            href="/rekomendasi/rekap-guru/"
            class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 rounded-xl shadow-lg shadow-teal-950/50 hover:shadow-teal-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
          >
            <span>Baca Informasi Lengkap</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=com.BiraaStudio.rekapguru"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-bold text-slate-300 hover:text-white bg-slate-950/80 hover:bg-slate-800/80 border border-slate-700/80 hover:border-slate-600 rounded-xl shadow-sm hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-teal-400"><polygon points="6 3 20 12 6 21 6 3"/></svg>
            <span>Google Play</span>
          </a>
        </div>
      </div>

      <!-- App Card 3: SiUjian -->
      <div class="group relative bg-gradient-to-b from-slate-900/90 via-slate-900/80 to-slate-950/90 border border-slate-800 hover:border-sky-500/40 rounded-3xl p-7 shadow-2xl backdrop-blur-xl transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_50px_rgba(14,165,233,0.15)] flex flex-col justify-between overflow-hidden">
        <!-- Top accent gradient sheen line -->
        <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-sky-500 via-blue-400 to-indigo-500 opacity-80 group-hover:opacity-100 transition-opacity"></div>
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-sky-500/10 rounded-full blur-2xl group-hover:bg-sky-500/20 transition-all pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between gap-4 pb-5 border-b border-slate-800">
            <div class="flex items-center gap-3.5">
              <div class="w-13 h-13 rounded-2xl bg-gradient-to-br from-sky-400 to-indigo-600 flex items-center justify-center text-white shadow-[0_0_20px_rgba(14,165,233,0.35)] shrink-0 group-hover:scale-105 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3z"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-xl font-extrabold text-white tracking-tight">SiUjian</h3>
                  <span class="px-2.5 py-0.5 text-[10px] font-extrabold uppercase bg-sky-500/15 text-sky-300 border border-sky-500/30 rounded-md tracking-wider">Secure Exam Browser</span>
                </div>
                <p class="text-xs text-slate-400 font-medium mt-1">Aplikasi Android untuk ujian online</p>
              </div>
            </div>
          </div>

          <div class="pt-5 space-y-5">
            <p class="text-slate-300 text-sm leading-relaxed font-normal">
              Menjalankan ujian dari Google Form dan platform web lain dalam mode terkunci menggunakan token, sistem penalti, dan Monitor Ujian. Bukan CBT atau LMS.
            </p>

            <div class="grid grid-cols-2 gap-2.5 pt-1 text-xs">
              <div class="bg-slate-950/70 border border-slate-800/80 group-hover:border-sky-500/20 rounded-xl p-3 text-center transition-colors">
                <div class="text-sky-300 font-extrabold text-xs">Token Ujian</div>
                <div class="text-[10px] text-slate-400 font-medium mt-0.5">Akses Terkontrol</div>
              </div>
              <div class="bg-slate-950/70 border border-slate-800/80 group-hover:border-sky-500/20 rounded-xl p-3 text-center transition-colors">
                <div class="text-white font-extrabold text-xs">Monitor Ujian</div>
                <div class="text-[10px] text-slate-400 font-medium mt-0.5">Fitur Premium</div>
              </div>
            </div>
          </div>
        </div>

        <div class="pt-6 flex flex-col sm:flex-row gap-2.5">
          <a
            href="/rekomendasi/siujian/"
            class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 rounded-xl shadow-lg shadow-sky-950/50 hover:shadow-sky-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
          >
            <span>Baca Informasi Lengkap</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=com.eduguard.eduguard"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-bold text-slate-300 hover:text-white bg-slate-950/80 hover:bg-slate-800/80 border border-slate-700/80 hover:border-slate-600 rounded-xl shadow-sm hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-sky-400"><polygon points="6 3 20 12 6 21 6 3"/></svg>
            <span>Google Play</span>
          </a>
        </div>
      </div>

      <!-- App Card 4: SiKelas -->
      <div class="group relative bg-gradient-to-b from-slate-900/90 via-slate-900/80 to-slate-950/90 border border-slate-800 hover:border-violet-500/40 rounded-3xl p-7 shadow-2xl backdrop-blur-xl transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_50px_rgba(139,92,246,0.15)] flex flex-col justify-between overflow-hidden">
        <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-violet-500 via-fuchsia-400 to-violet-600 opacity-80 group-hover:opacity-100 transition-opacity"></div>
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-violet-500/10 rounded-full blur-2xl group-hover:bg-violet-500/20 transition-all pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between gap-4 pb-5 border-b border-slate-800">
            <div class="flex items-center gap-3.5">
              <div class="w-13 h-13 rounded-2xl bg-gradient-to-br from-violet-400 to-fuchsia-600 flex items-center justify-center text-white shadow-[0_0_20px_rgba(139,92,246,0.35)] shrink-0 group-hover:scale-105 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-xl font-extrabold text-white tracking-tight">SiKelas</h3>
                  <span class="px-2.5 py-0.5 text-[10px] font-extrabold uppercase bg-violet-500/15 text-violet-300 border border-violet-500/30 rounded-md tracking-wider">Kelas Digital</span>
                </div>
                <p class="text-xs text-slate-400 font-medium mt-1">Guru, siswa, dan orang tua</p>
              </div>
            </div>
          </div>

          <div class="pt-5 space-y-5">
            <p class="text-slate-300 text-sm leading-relaxed font-normal">
              Manajemen dan komunikasi kelas melalui pengumuman, agenda, konfirmasi, tugas, jurnal kebiasaan, serta izin tidak masuk. Anggota bergabung memakai kode kelas 6 digit.
            </p>

            <div class="grid grid-cols-2 gap-2.5 pt-1 text-xs">
              <div class="bg-slate-950/70 border border-slate-800/80 group-hover:border-violet-500/20 rounded-xl p-3 text-center transition-colors">
                <div class="text-violet-300 font-extrabold text-xs">3 Peran</div>
                <div class="text-[10px] text-slate-400 font-medium mt-0.5">Satu Kelas Digital</div>
              </div>
              <div class="bg-slate-950/70 border border-slate-800/80 group-hover:border-violet-500/20 rounded-xl p-3 text-center transition-colors">
                <div class="text-white font-extrabold text-xs">6 Digit</div>
                <div class="text-[10px] text-slate-400 font-medium mt-0.5">Kode Kelas</div>
              </div>
            </div>
          </div>
        </div>

        <div class="pt-6 flex flex-col sm:flex-row gap-2.5">
          <a
            href="/rekomendasi/sikelas/"
            class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 rounded-xl shadow-lg shadow-violet-950/50 hover:shadow-violet-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
          >
            <span>Baca Informasi Lengkap</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=com.biraastudio.sikelas"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-bold text-slate-300 hover:text-white bg-slate-950/80 hover:bg-slate-800/80 border border-slate-700/80 hover:border-slate-600 rounded-xl shadow-sm hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-violet-400"><polygon points="6 3 20 12 6 21 6 3"/></svg>
            <span>Google Play</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Developer & Hub Links -->
    <div class="mt-14 text-center flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-8">
      <a 
        href="/rekomendasi/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-slate-900/90 hover:bg-slate-800/90 border border-emerald-500/30 text-sm font-bold text-emerald-400 hover:text-emerald-300 shadow-[0_0_15px_rgba(16,185,129,0.1)] transition-all group backdrop-blur-md"
      >
        <span>Lihat Semua Rekomendasi Aplikasi Guru</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="lucide lucide-arrow-right transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>

      <a 
        href="https://play.google.com/store/apps/dev?id=8704276077631485252" 
        target="_blank" 
        rel="noopener noreferrer"

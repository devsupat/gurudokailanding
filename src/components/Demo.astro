---
---
<section class="py-20 bg-gray-50/50 border-y border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">
        Lihat Sendiri Bedanya
      </h2>
      <p class="text-lg text-gray-600 font-medium">
        Bandingkan waktu dan tenaga yang Anda hemat dengan menggunakan AI asisten.
      </p>
    </div>

    <!-- Before / After Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch mb-16">
      
      <!-- Before (Cara Lama) -->
      <div class="bg-white border border-gray-200 rounded-3xl p-8 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-lg bg-gray-100 text-gray-500 flex items-center justify-center font-bold">
              ❌
            </div>
            <div>
              <h3 class="text-xl font-bold text-gray-900">Cara Lama (Manual)</h3>
              <p class="text-xs text-gray-400 font-bold uppercase tracking-wider">3 - 4 Jam Terbuang</p>
            </div>
          </div>
          
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-rose-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <span class="text-gray-700 font-medium">Buka Microsoft Word & cari template RPP lama</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-rose-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <span class="text-gray-700 font-medium">Cari referensi capaian pembelajaran secara online</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-rose-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <span class="text-gray-700 font-medium">Ketik manual indikator, materi, & bank soal satu per satu</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-rose-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <span class="text-gray-700 font-medium">Rapikan format, atur margin, & perbaiki typo</span>
            </li>
          </ul>
        </div>
        <div class="mt-8 pt-6 border-t border-gray-100 flex items-center justify-between text-gray-500">
          <span class="font-semibold">Total Waktu:</span>
          <span class="font-bold text-rose-600 bg-rose-50 px-3 py-1 rounded-full text-sm">~ 180 Menit / RPP</span>
        </div>
      </div>

      <!-- After (GuruDokAI) -->
      <div class="bg-brand-light border-2 border-brand-primary rounded-3xl p-8 shadow-premium-lg flex flex-col justify-between relative overflow-hidden">
        <!-- Shine effect -->
        <div class="absolute -top-12 -right-12 w-32 h-32 bg-brand-primary/10 rounded-full blur-xl"></div>
        
        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-brand-primary text-white flex items-center justify-center font-bold shadow-md shadow-brand-primary/10">
                ✨
              </div>
              <div>
                <h3 class="text-xl font-bold text-gray-900">Dengan GuruDokAI (Otomatis)</h3>
                <p class="text-xs text-brand-primary font-extrabold uppercase tracking-wider">Hanya 2 Menit</p>
              </div>
            </div>
            <span class="bg-brand-primary text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">Rekomendasi</span>
          </div>

          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-brand-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-800 font-semibold">Buka website/aplikasi GuruDokAI di HP atau laptop</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-brand-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-800 font-semibold">Pilih Mata Pelajaran, Kelas, dan Topik Pembelajaran</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-brand-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-800 font-semibold">Klik "Generate" & biarkan AI menyusun dokumen lengkap</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="h-5 w-5 text-brand-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-800 font-semibold">Selesai! Langsung cetak atau edit hasil ekspor PDF</span>
            </li>
          </ul>
        </div>
        <div class="mt-8 pt-6 border-t border-brand-primary/20 flex items-center justify-between text-gray-800">
          <span class="font-bold">Total Waktu:</span>
          <span class="font-bold text-white bg-brand-primary px-3 py-1 rounded-full text-sm shadow-sm">2 Menit Saja!</span>
        </div>
      </div>

    </div>

    <!-- Statistics -->
    <div class="bg-white rounded-3xl border border-gray-100 p-8 shadow-premium">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 divide-y sm:divide-y-0 sm:divide-x divide-gray-100 text-center">
        
        <!-- Stat 1 -->
        <div class="py-4 sm:py-0">
          <div class="text-5xl font-extrabold text-brand-primary mb-2">2 Menit</div>
          <div class="text-sm font-bold text-gray-500 uppercase tracking-wider">Rata-rata Waktu Pembuatan</div>
        </div>

        <!-- Stat 2 -->
        <div class="py-4 sm:py-0 sm:pl-8">
          <div class="text-5xl font-extrabold text-brand-primary mb-2">15+ Dokumen</div>
          <div class="text-sm font-bold text-gray-500 uppercase tracking-wider">Jenis Administrasi Guru</div>
        </div>

        <!-- Stat 3 -->
        <div class="py-4 sm:py-0 sm:pl-8">
          <div class="text-5xl font-extrabold text-brand-primary mb-2">100%</div>
          <div class="text-sm font-bold text-gray-500 uppercase tracking-wider">Sesuai Kurikulum Merdeka</div>
        </div>

      </div>
    </div>

  </div>
</section>

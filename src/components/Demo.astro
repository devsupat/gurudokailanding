              </tr>
              <tr>
                <td class="py-4 px-6 font-bold text-gray-900">Investasi Biaya & Energi</td>
                <td class="py-4 px-6 text-gray-500 font-medium">Biaya waktu & energi yang sangat besar</td>
                <td class="py-4 px-6 bg-brand-light/30 text-brand-dark font-extrabold text-brand-primary">
                  ⭐ Mulai Rp 19 Ribu saja!
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</section>

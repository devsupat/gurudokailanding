    <!-- Comparison Table Section -->
    <div class="mt-20">
      <div class="text-center max-w-3xl mx-auto mb-10 space-y-3">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
          Perbandingan Detail: Kenapa GuruDokAI Berbeda?
        </h3>
        <p class="text-base text-gray-500 font-medium">
          Berikut adalah perbandingan fitur dan efisiensi antara metode penyusunan manual dengan bantuan AI GuruDokAI.
        </p>
      </div>

      <div class="overflow-hidden border border-gray-150 rounded-2xl bg-white shadow-premium">
        <div class="min-w-[640px] overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50/75 border-b border-gray-150 text-[11px] font-bold text-gray-400 uppercase tracking-wider">
                <th class="py-4 px-6 w-1/3">Aspek Perbandingan</th>
                <th class="py-4 px-6 w-1/3">Cara Lama (Manual)</th>
                <th class="py-4 px-6 w-1/3 bg-brand-light/40 text-brand-primary">Dengan GuruDokAI</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-150 text-xs sm:text-sm font-semibold text-gray-600">
              <tr>
                <td class="py-4 px-6 font-bold text-gray-900">Waktu Pembuatan 1 Dokumen</td>
                <td class="py-4 px-6 text-gray-500 font-medium">3 - 6 Jam (Sangat melelahkan)</td>
                <td class="py-4 px-6 bg-brand-light/30 text-brand-dark font-extrabold">
                  ⚡ Kurang dari 2 Menit
                </td>
              </tr>
              <tr>
                <td class="py-4 px-6 font-bold text-gray-900">Kesesuaian Kurikulum Merdeka</td>
                <td class="py-4 px-6 text-gray-500 font-medium">Harus riset manual regulasi terbaru</td>
                <td class="py-4 px-6 bg-brand-light/30 text-brand-dark font-extrabold">
                  ✅ Otomatis & terverifikasi standar terbaru
                </td>
              </tr>
              <tr>
                <td class="py-4 px-6 font-bold text-gray-900">Format & Lembar Pengesahan</td>
                <td class="py-4 px-6 text-gray-500 font-medium">Harus menyusun & merapikan layout sendiri</td>
                <td class="py-4 px-6 bg-brand-light/30 text-brand-dark font-extrabold">
                  ✅ Rapi, profesional & siap pakai
                </td>
              </tr>
              <tr>
                <td class="py-4 px-6 font-bold text-gray-900">Format Ekspor File</td>
                <td class="py-4 px-6 text-gray-500 font-medium">Atur margin & layout Word manual</td>
                <td class="py-4 px-6 bg-brand-light/30 text-brand-dark font-extrabold">
                  ✅ 1-Klik Download PDF & Word (.docx)
                </td>
              </tr>
              <tr>
                <td class="py-4 px-6 font-bold text-gray-900">Konsistensi Antar Dokumen</td>

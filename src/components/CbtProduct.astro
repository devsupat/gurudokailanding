      <!-- Instructions & WA Action Button -->
      <div class="space-y-3">
        <p class="text-xs text-slate-500 text-center font-medium">
          Setelah pembayaran, kirim bukti pembayaran untuk proses setup CBT sekolah Anda.
        </p>

        <button
          id="cbt-qris-confirm-btn"
          type="button"
          class="w-full flex items-center justify-center gap-2 py-3.5 px-6 text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-700 rounded-2xl shadow-lg shadow-emerald-600/20 transition-all hover:scale-[1.01] cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
          Saya Sudah Bayar (Kirim Bukti via WA)
        </button>
      </div>

    </div>
  </div>
</div>

<script>
  const openBtns        = document.querySelectorAll('.cbt-open-qris-btn');
  const modal           = document.getElementById('cbt-qris-modal');
  const modalContainer  = document.getElementById('cbt-qris-container');
  const closeBtn        = document.getElementById('close-cbt-qris-modal-btn');
  const confirmBtn      = document.getElementById('cbt-qris-confirm-btn');

  const waNumber = '6285189536359';

  function openCbtModal() {
    if (!modal || !modalContainer) return;
    modal.classList.remove('hidden');
    void modal.offsetWidth;
    modal.classList.add('opacity-100');
    modalContainer.classList.add('scale-100', 'opacity-100');
    modalContainer.classList.remove('scale-95', 'opacity-0');
    document.body.style.overflow = 'hidden';
  }

  function closeCbtModal() {
    if (!modal || !modalContainer) return;
    modal.classList.remove('opacity-100');
    modalContainer.classList.remove('scale-100', 'opacity-100');
    modalContainer.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 300);
  }

  openBtns.forEach(btn => btn.addEventListener('click', openCbtModal));
  if (closeBtn) closeBtn.addEventListener('click', closeCbtModal);

  if (confirmBtn) {
    confirmBtn.addEventListener('click', () => {
      const msg = "Halo Admin GuruDokAI.\n\nSaya sudah melakukan pembayaran untuk produk CBT Sekolah (Rp100.000 - Sekali Bayar/Lifetime).\n\nMohon bantu proses setup tenant CBT sekolah kami.\n\nTerima kasih.";
      const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;
      window.open(waUrl, '_blank', 'noopener,noreferrer');
    });
  }

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeCbtModal();
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeCbtModal();
    }
  });
</script>

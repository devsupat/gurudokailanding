---
---
<section id="fitur" class="py-20 bg-brand-light/60 scroll-mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">
        Satu Aplikasi. <span class="text-brand-primary">Puluhan Fitur Ultimate.</span>
      </h2>
      <p class="text-lg text-gray-600 font-medium">
        Bukan sekadar pembuat Modul Ajar. GuruDokAI Ultimate adalah platform AI terlengkap untuk membantu hampir seluruh pekerjaan administrasi guru Indonesia.
      </p>
    </div>

    <!-- Category 1: Perangkat Pembelajaran Utama -->
    <div class="mb-16">
      <h3 class="text-xl font-bold text-gray-800 mb-6 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-brand-primary rounded-full"></span>
        Perangkat Pembelajaran Utama (Kurikulum Merdeka)
      </h3>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <!-- RPP Merdeka -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Aplikasi RPP Otomatis</h4>
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
              Selesaikan RPP otomatis Kurikulum Merdeka & Permendikdasmen No.13/2025 (Deep Learning) secara instan.
            </p>
          </div>
        </div>

        <!-- Modul Ajar -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10M6 10h10"/></svg>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Generator Modul Ajar</h4>
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
              Aplikasi modul ajar lengkap dengan LKPD (Lembar Kerja Peserta Didik) terstruktur, tinggal download.
            </p>
          </div>
        </div>

        <!-- TP -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Tujuan Pembelajaran (TP)</h4>
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
              Rumuskan dan buat poin-poin Tujuan Pembelajaran (TP) secara sistematis berdasarkan fase kelas.
            </p>
          </div>
        </div>

        <!-- ATP -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m16 16 4-4-4-4"/><path d="M20 12H4M4 12V4"/></svg>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Generator ATP</h4>
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
              Generator Alur Tujuan Pembelajaran (ATP) yang runtut dari awal hingga akhir fase secara otomatis.
            </p>
          </div>
        </div>

        <!-- KKTP -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Generator KKTP</h4>
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
              Generator Kriteria Ketercapaian Tujuan Pembelajaran untuk menentukan kelayakan & ketuntasan belajar siswa.
            </p>
          </div>
        </div>

        <!-- Prota -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Program Tahunan (Prota)</h4>
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
              Rencana alokasi waktu satu tahun pelajaran untuk membantu guru mencapai target kompetensi kelas.
            </p>
          </div>
        </div>

        <!-- Prosem -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h8M8 18h5"/></svg>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Program Semester (Prosem)</h4>
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
              Distribusi alokasi materi pelajaran per minggu secara detail dalam format semester.
            </p>
          </div>
        </div>

        <!-- Jurnal Pembelajaran -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Jurnal Pembelajaran</h4>
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
              Catatan harian proses mengajar guru, pencapaian kompetensi kelas, beserta jurnal refleksi.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Category 2: Asisten & Manajemen Kelas -->
    <div class="mb-16">
      <h3 class="text-xl font-bold text-gray-800 mb-6 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-brand-primary rounded-full"></span>
        Asisten & Manajemen Kelas
      </h3>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <!-- AI Asisten Guru -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">AI Asisten Guru</h4>
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
              Tanya jawab instan mengenai kurikulum BSKAP terbaru, metodifikasi ajar, dan tips mengajar kreatif.
            </p>
          </div>
        </div>

        <!-- Bank Soal AI HOTS -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"/><path d="M9 13h6"/><path d="M12 10v6"/></svg>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Bank Soal AI HOTS</h4>
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
              Buat soal ujian pilihan ganda & essay tingkat berpikir tinggi (HOTS) beserta kunci jawaban lengkap.
            </p>
          </div>
        </div>

        <!-- Presensi Siswa -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Presensi Siswa</h4>
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
              Sistem pencatatan kehadiran & absensi siswa kelas secara praktis dan terdokumentasi rapi.
            </p>
          </div>
        </div>

        <!-- Kalender Akademik -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01"/></svg>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Kalender Akademik</h4>
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
              Kelola waktu efektif belajar, jadwal libur, pekan ujian, serta rekap kegiatan sekolah terpadu.
            </p>
          </div>
        </div>

        <!-- Generator Jadwal -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M15 3v18M3 9h18M3 15h18"/></svg>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Generator Jadwal</h4>
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
              Kelola susunan jadwal pelajaran mingguan kelas secara cerdas tanpa risiko bentrok jam mengajar.
            </p>
          </div>
        </div>

        <!-- Acak Kelompok -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Acak Kelompok</h4>
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
              Bagi siswa ke dalam kelompok diskusi secara acak, merata, dan transparan dalam hitungan detik.
            </p>
          </div>
        </div>

        <!-- Timer Kelas -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Timer Kelas</h4>
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
              Alat stopwatch & countdown interaktif untuk batasan waktu kuis, ujian, atau presentasi kelompok.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Category 3: Tools & Media Downloader -->
    <div>
      <h3 class="text-xl font-bold text-gray-800 mb-6 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-brand-primary rounded-full"></span>
        Tools & Media Downloader
      </h3>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <!-- PDF Tools -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="M12 18v-6M8 15h8"/></svg>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">PDF Tools</h4>
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
              Gabungkan, pisahkan, kompres ukuran, atau konversi dokumen PDF pendukung ajar dengan cepat.
            </p>
          </div>
        </div>

        <!-- Scribd Downloader -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Scribd Downloader</h4>
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
              Unduh dokumen referensi materi pelajaran, silabus, dan contoh modul dari perpustakaan Scribd secara langsung.
            </p>
          </div>
        </div>

        <!-- Pinterest Downloader -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8c-1.5 0-3 1.5-3 3 0 1.5 1.5 3 3 3s3-1.5 3-3c0-1.5-1.5-3-3-3z"/><path d="M12 2v6M12 16v6M2 12h6M16 12h6"/></svg>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Pinterest Downloader</h4>
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
              Ambil gambar ilustrasi pembelajaran kreatif atau ide poster dekorasi kelas menarik dari Pinterest.
            </p>
          </div>
        </div>

        <!-- Video Downloader -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="15" x="2" y="5" rx="2" ry="2"/><path d="m10 10 5 3-5 3v-6Z"/></svg>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">TikTok & YT Downloader</h4>
            <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
              Unduh video edukasi beresolusi tinggi dari YouTube & TikTok untuk diputar offline secara aman di kelas.
            </p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

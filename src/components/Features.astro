---
---
<section id="fitur" class="py-20 bg-brand-light/60 scroll-mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">
        Semua yang Guru Butuhkan, <span class="text-brand-primary">Dalam Satu Aplikasi</span>
      </h2>
      <p class="text-lg text-gray-600 font-medium">
        Tidak perlu berpindah aplikasi. GuruDokAI melengkapi semua kebutuhan administrasi mengajar Anda.
      </p>
    </div>

    <!-- 8 Features Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      
      <!-- Feature 1: RPP Otomatis -->
      <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-lg bg-brand-light text-brand-primary flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">RPP Otomatis</h3>
          <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
            Sesuai Kurikulum Merdeka & Permendikdasmen No.13/2025.
          </p>
        </div>
      </div>

      <!-- Feature 2: Modul Ajar -->
      <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-lg bg-brand-light text-brand-primary flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Modul Ajar</h3>
          <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
            Siap cetak, lengkap dengan LKPD (Lembar Kerja Peserta Didik).
          </p>
        </div>
      </div>

      <!-- Feature 3: Bank Soal HOTS -->
      <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-lg bg-brand-light text-brand-primary flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-brain-circuit"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"/><path d="M9 13h6"/><path d="M12 10v6"/></svg>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Bank Soal HOTS</h3>
          <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
            Pilihan ganda, essay, lengkap dengan kunci jawaban detail.
          </p>
        </div>
      </div>

      <!-- Feature 4: ATP Otomatis -->
      <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-lg bg-brand-light text-brand-primary flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-milestone"><path d="M18 6H5a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h13l4-3.5L18 6Z"/><path d="M12 13v8"/><path d="M12 3v3"/></svg>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">ATP Otomatis</h3>
          <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
            Alur Tujuan Pembelajaran otomatis terstruktur per semester.
          </p>
        </div>
      </div>

      <!-- Feature 5: Prota & Prosem -->
      <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-lg bg-brand-light text-brand-primary flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-range"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M17 14h-6"/><path d="M13 18H7"/></svg>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Prota & Prosem</h3>
          <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
            Program Tahunan & Program Semester tersusun dalam hitungan detik.
          </p>
        </div>
      </div>

      <!-- Feature 6: Export PDF & Word -->
      <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-lg bg-brand-light text-brand-primary flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download-cloud"><path d="M12 13v8M8 17l4 4 4-4"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/><path d="M12 13h.01"/></svg>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Ekspor PDF</h3>
          <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
            Download langsung hasil dokumen Anda, siap cetak rapi.
          </p>
        </div>
      </div>

      <!-- Feature 7: AI Asisten Guru -->
      <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-lg bg-brand-light text-brand-primary flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-square"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">AI Asisten Guru</h3>
          <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
            Tanya apa saja seputar materi pembelajaran & administrasi sekolah.
          </p>
        </div>
      </div>

      <!-- Feature 8: Full Administrasi -->
      <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-premium hover-scale flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-lg bg-brand-light text-brand-primary flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-grid"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">Full Administrasi</h3>
          <p class="text-xs sm:text-sm text-gray-500 leading-relaxed font-medium">
            Seluruh berkas guru lengkap dan rapi dalam satu platform.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
